# Source template only; no credentials or deployment is created by init.
OKF_BIND=127.0.0.1:7711
# OKF_DATA_DIR: unset uses the per-user local data directory; when set, must be absolute.
# OKF_DATA_DIR=/absolute/path/to/okf-jawn-data
OKF_PUBLIC_ORIGIN=http://127.0.0.1:7711
# OKF_SANDBOX_BIND: defaults to OKF_BIND's address and next port (port 0 stays 0).
OKF_SANDBOX_BIND=127.0.0.1:7712
# OKF_SANDBOX_ORIGIN: defaults to the bound loopback address locally; required in hosted mode.
# Hosted public and sandbox origins must use HTTPS and different hosts.
OKF_SANDBOX_ORIGIN=http://127.0.0.1:7712
# OKF_ALLOWED_HOSTS: unset accepts the public origin's authority; an override is comma-separated.
# OKF_UI_DIR: unset uses ui beside the executable; an override must be an absolute directory.
# OKF_MCP_APP: unset uses mcp-apps/app.html beside the executable; an override must be absolute.
# OKF_CONVERTER: unset uses okf-jawn-convert (with .exe on Windows) beside the executable.
# A converter override must be an absolute executable path.
# OKF_CONVERTER_MEMORY_LIMIT_BYTES: defaults to 4294967296 (4 GiB), minimum 268435456.
OKF_CONVERTER_MEMORY_LIMIT_BYTES=4294967296
# OKF_TRUSTED_PROXIES: unset trusts none; set only the ingress proxy IPs, comma-separated.
# Hosted Compose requires this setting; replace the placeholder with the actual ingress IPs.
# OKF_TRUSTED_PROXIES=<ingress-proxy-ip>
# Do not assign empty values to optional OKF settings: omit them to use their defaults.
# local: one installation-owned identity and local session. workos: hosted AuthKit/Connect.
# workos with missing or invalid settings fails startup; it never falls back to local.
OKF_AUTH_MODE=local
# Hosted setup: select workos, use HTTPS origins, and configure the intended ingress.
# Forward Host and Origin unchanged; route the separate sandbox host to its listener.
# WorkOS Resource Indicator must identify the externally reachable /mcp endpoint.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_ISSUER=
WORKOS_MCP_RESOURCE=
WORKOS_REDIRECT_URI=
# Build images for deploy/compose.yaml, which refuses to build while any of them is empty.
# BUN_IMAGE: digest-pinned oven/bun image of the release in .bun-version; doctor rejects any other.
# RUST_IMAGE: digest-pinned Rust image for the toolchain in rust-toolchain.toml.
# RUNTIME_IMAGE: qualified digest-pinned runtime image for the application target.
# It must provide the native converter libraries compatible with the selected build image.
BUN_IMAGE=
RUST_IMAGE=
RUNTIME_IMAGE=
# DOCLING_MODELS_DIR: absolute host path to the owner's qualified model tree, readable by UID 65532.
# Compose mounts it read-only at /opt/docling/models; a missing path is refused, not created.
# Qualify the exact Linux image, native libraries and model bytes before release; a local
# Windows qualification does not qualify this image. No models are published by this template.
DOCLING_MODELS_DIR=
