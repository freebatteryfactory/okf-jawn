{
  "$defs": {
    "Change": {
      "description": "Permitted proposal mutations; no review or acceptance variants exist.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Create a note or View with retained properties.",
          "properties": {
            "body": {
              "description": "Body.",
              "type": "string"
            },
            "kind": {
              "const": "create",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/WorkspacePath",
              "description": "Path."
            },
            "properties": {
              "additionalProperties": true,
              "description": "Properties.",
              "type": "object"
            },
            "type_name": {
              "description": "Type name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "type_name",
            "body",
            "properties"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Replace authored content with preconditions.",
          "properties": {
            "body": {
              "description": "Body.",
              "type": "string"
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Item id."
            },
            "kind": {
              "const": "edit",
              "type": "string"
            },
            "properties": {
              "additionalProperties": true,
              "description": "Properties.",
              "type": "object"
            }
          },
          "required": [
            "kind",
            "item_id",
            "body",
            "properties"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move and rewrite links.",
          "properties": {
            "destination": {
              "$ref": "#/$defs/WorkspacePath",
              "description": "Destination."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Item id."
            },
            "kind": {
              "const": "move",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "item_id",
            "destination"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Retire an item without deleting retained objects.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Item id."
            },
            "kind": {
              "const": "archive",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "item_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Propose the complete text of an unprocessed source.",
          "properties": {
            "based_on": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Digest the agent saw; absent when the source has none. A different current digest is a conflict."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Source item."
            },
            "kind": {
              "const": "supply_extraction",
              "type": "string"
            },
            "markdown": {
              "description": "The complete proposed text, Markdown.",
              "type": "string"
            },
            "pages": {
              "description": "Pages the text covers, as the agent claims; empty for the whole.",
              "items": {
                "$ref": "#/$defs/PageRange"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "item_id",
            "markdown"
          ],
          "type": "object"
        }
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "IdempotencyKey": {
      "description": "Caller-chosen retry identity for one write, scoped to tenant, subject and operation.",
      "format": "uuid",
      "type": "string"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^/\\\\:<>\"|?*\\x00-\\x1f]+(/[^/\\\\:<>\"|?*\\x00-\\x1f]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Suggest changes without changing the accepted workspace.",
  "properties": {
    "base_revision": {
      "$ref": "#/$defs/Revision",
      "description": "Exact revision on which this change is based; stale writes conflict."
    },
    "changes": {
      "description": "Allowed suggestion mutations.",
      "items": {
        "$ref": "#/$defs/Change"
      },
      "type": "array"
    },
    "description": {
      "description": "Reason and limitations.",
      "type": "string"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey",
      "description": "Retry identity."
    },
    "title": {
      "description": "Proposal title.",
      "type": "string"
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "workspace_id",
    "base_revision",
    "title",
    "description",
    "changes",
    "idempotency_key"
  ],
  "title": "OpenProposalRequest",
  "type": "object"
}
