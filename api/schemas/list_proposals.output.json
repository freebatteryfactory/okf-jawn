{
  "$defs": {
    "AccessRoute": {
      "description": "How authenticated authority reached the application.\n\nLocal and hosted entry paths both resolve to one of these routes and share the same\nauthorization rules; no route is granted authority because the connection is loopback.",
      "oneOf": [
        {
          "const": "browser_session",
          "description": "Hosted Explorer session established through WorkOS AuthKit.",
          "type": "string"
        },
        {
          "const": "mcp_delegation",
          "description": "External agent: a WorkOS Connect token when hosted, a local connector credential when local.",
          "type": "string"
        },
        {
          "const": "local_owner",
          "description": "The installation-local owner identity, authenticated through the local browser session.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "Configured internal service identity.",
          "type": "string"
        }
      ]
    },
    "Change": {
      "description": "Permitted proposal mutations; no review or acceptance variants exist.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Create a note or View with retained properties.",
          "properties": {
            "body": {
              "description": "Body.",
              "type": "string"
            },
            "kind": {
              "const": "create",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/WorkspacePath",
              "description": "Path."
            },
            "properties": {
              "additionalProperties": true,
              "description": "Properties.",
              "type": "object"
            },
            "type_name": {
              "description": "Type name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "type_name",
            "body",
            "properties"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Replace authored content with preconditions.",
          "properties": {
            "body": {
              "description": "Body.",
              "type": "string"
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Item id."
            },
            "kind": {
              "const": "edit",
              "type": "string"
            },
            "properties": {
              "additionalProperties": true,
              "description": "Properties.",
              "type": "object"
            }
          },
          "required": [
            "kind",
            "item_id",
            "body",
            "properties"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Move and rewrite links.",
          "properties": {
            "destination": {
              "$ref": "#/$defs/WorkspacePath",
              "description": "Destination."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Item id."
            },
            "kind": {
              "const": "move",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "item_id",
            "destination"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Retire an item without deleting retained objects.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Item id."
            },
            "kind": {
              "const": "archive",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "item_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Propose the complete text of an unprocessed source.",
          "properties": {
            "based_on": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Digest the agent saw; absent when the source has none. A different current digest is a conflict."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Source item."
            },
            "kind": {
              "const": "supply_extraction",
              "type": "string"
            },
            "markdown": {
              "description": "The complete proposed text, Markdown.",
              "type": "string"
            },
            "pages": {
              "description": "Pages the text covers, as the agent claims; empty for the whole.",
              "items": {
                "$ref": "#/$defs/PageRange"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "item_id",
            "markdown"
          ],
          "type": "object"
        }
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "description": "A revision-bound proposed change set.",
      "properties": {
        "base_revision": {
          "$ref": "#/$defs/Revision",
          "description": "Base on which the proposal was drafted."
        },
        "changes": {
          "description": "Proposed mutations.",
          "items": {
            "$ref": "#/$defs/Change"
          },
          "type": "array"
        },
        "client_id": {
          "description": "OAuth or connector client it came through, recorded by the server.",
          "type": [
            "string",
            "null"
          ]
        },
        "content_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Server-computed digest of the exact displayed change set."
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Creation time."
        },
        "created_by": {
          "description": "Server-recorded principal.",
          "type": "string"
        },
        "created_via": {
          "$ref": "#/$defs/AccessRoute",
          "description": "Route the proposal came by, recorded by the server."
        },
        "description": {
          "description": "Rationale and limitations.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ProposalId",
          "description": "Proposal identity."
        },
        "kind": {
          "$ref": "#/$defs/ProposalKind",
          "description": "What the proposal does, derived from `changes` by the server."
        },
        "proposal_revision": {
          "$ref": "#/$defs/Revision",
          "description": "Exact proposed content."
        },
        "status": {
          "$ref": "#/$defs/ProposalStatus",
          "description": "Current suggestion state."
        },
        "title": {
          "description": "Human-readable reason.",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Workspace whose permissions and storage scope apply."
        }
      },
      "required": [
        "id",
        "workspace_id",
        "base_revision",
        "proposal_revision",
        "content_digest",
        "title",
        "description",
        "changes",
        "kind",
        "status",
        "created_by",
        "created_via",
        "created_at"
      ],
      "type": "object"
    },
    "ProposalId": {
      "description": "Identity of a suggested change set, not a review.",
      "format": "uuid",
      "type": "string"
    },
    "ProposalKind": {
      "description": "What a proposal does; derived from its changes, never chosen by the proposer.",
      "oneOf": [
        {
          "const": "content",
          "description": "Content changes: create, edit, move, archive.",
          "type": "string"
        },
        {
          "const": "supply_extraction",
          "description": "Agent-supplied extraction text.",
          "type": "string"
        }
      ]
    },
    "ProposalStatus": {
      "description": "Lifecycle of a suggestion, not approval of a fact in it.",
      "oneOf": [
        {
          "const": "open",
          "description": "Available for review.",
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "Merged by an authorized action.",
          "type": "string"
        },
        {
          "const": "declined",
          "description": "Closed without applying changes.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Base state changed; reconciliation required.",
          "type": "string"
        }
      ]
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^/\\\\:<>\"|?*\\x00-\\x1f]+(/[^/\\\\:<>\"|?*\\x00-\\x1f]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Paged proposals.",
  "properties": {
    "items": {
      "description": "Visible proposals.",
      "items": {
        "$ref": "#/$defs/Proposal"
      },
      "type": "array"
    },
    "next_cursor": {
      "description": "Continuation cursor.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items"
  ],
  "title": "ListProposalsResponse",
  "type": "object"
}
