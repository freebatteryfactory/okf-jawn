{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "description": "A safe error response, not an internal backtrace.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "description": "Stable code for programmatic handling."
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "description": "Typed context for conflict, replay, and in-progress outcomes."
        },
        "field": {
          "description": "Input field needing correction.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Safe explanation for the caller.",
          "type": "string"
        },
        "request_id": {
          "description": "Correlation identifier, not a secret.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ArtifactId": {
      "description": "Identity of a retained export or backup artifact.",
      "format": "uuid",
      "type": "string"
    },
    "ConnectorId": {
      "description": "Identity of one local MCP connector credential, never the owner's browser session.",
      "format": "uuid",
      "type": "string"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "DownloadArtifact": {
      "additionalProperties": false,
      "description": "An authorized export or backup artifact with integrity metadata.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId",
          "description": "Stable downloadable artifact."
        },
        "download_path": {
          "description": "Application-relative authorized download path.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the archive."
        },
        "size": {
          "description": "Byte count as a decimal string to preserve integer precision.",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "size",
        "download_path"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable failure classifications; HTTP and MCP adapters preserve these.",
      "oneOf": [
        {
          "const": "invalid_input",
          "description": "Input violates the declared contract.",
          "type": "string"
        },
        {
          "const": "unauthenticated",
          "description": "No acceptable identity was established.",
          "type": "string"
        },
        {
          "const": "forbidden",
          "description": "The principal lacks the required capability.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The resource is absent or not visible to this principal.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "A precondition, revision, draft-base, or idempotency-key conflict occurred.",
          "type": "string"
        },
        {
          "const": "already_issued",
          "description": "A secret-bearing write already completed; replaying it never returns the secret again.",
          "type": "string"
        },
        {
          "const": "in_progress",
          "description": "Another attempt with the same idempotency key holds a live lease; retry later.",
          "type": "string"
        },
        {
          "const": "too_large",
          "description": "A configured resource limit was exceeded.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The requested representation or format is unsupported.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "A configured integration is unavailable.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The operation was cancelled.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "An unexpected server failure occurred without exposing secrets.",
          "type": "string"
        }
      ]
    },
    "ErrorDetail": {
      "description": "Typed failure context the UI and agents can act on without parsing messages.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The connector was already issued under this idempotency key; its secret is not replayed.",
          "properties": {
            "connector_id": {
              "$ref": "#/$defs/ConnectorId",
              "description": "Connector created by the original request."
            },
            "kind": {
              "const": "already_issued",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "connector_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An identical request is executing under a live lease.",
          "properties": {
            "kind": {
              "const": "in_progress",
              "type": "string"
            },
            "mutation_id": {
              "$ref": "#/$defs/MutationId",
              "description": "Mutation holding the lease."
            },
            "retry_after": {
              "description": "Whole seconds the caller should wait before retrying the same request.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "mutation_id",
            "retry_after"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The head moved under a draft; the editor resolves and saves against the new head.",
          "properties": {
            "current_revision": {
              "$ref": "#/$defs/Revision",
              "description": "Head revision at which the item changed or was deleted."
            },
            "diff": {
              "description": "Structured comparison between the draft base and the current revision."
            },
            "draft_base": {
              "$ref": "#/$defs/Revision",
              "description": "Revision the draft was based on."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Item whose draft no longer applies cleanly."
            },
            "kind": {
              "const": "draft_conflict",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "item_id",
            "draft_base",
            "current_revision",
            "diff"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The idempotency key was reused with a different request body.",
          "properties": {
            "kind": {
              "const": "idempotency_conflict",
              "type": "string"
            },
            "operation": {
              "$ref": "#/$defs/OperationName",
              "description": "Operation that first used the key."
            }
          },
          "required": [
            "kind",
            "operation"
          ],
          "type": "object"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "JobId": {
      "description": "Durable background work identity retained across retries.",
      "format": "uuid",
      "type": "string"
    },
    "JobState": {
      "description": "Job progress retained independently of diagnostic traces.",
      "oneOf": [
        {
          "const": "queued",
          "description": "Durably registered for execution.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Execution attempt in progress.",
          "type": "string"
        },
        {
          "const": "succeeded",
          "description": "Committed output is available.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Failure retained with retry information.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Explicit cancellation completed.",
          "type": "string"
        }
      ]
    },
    "MutationId": {
      "description": "Durable server-assigned identity of one write; every store that creates a row enforces it as unique.",
      "format": "uuid",
      "type": "string"
    },
    "OperationName": {
      "description": "Closed set of canonical operation identifiers, serialized as the `snake_case` id.",
      "oneOf": [
        {
          "const": "list_workspaces",
