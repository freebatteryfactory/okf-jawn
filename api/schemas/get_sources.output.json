{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Docling's bounding box, copied as the converter gave it (rounded to two decimals).",
      "properties": {
        "b": {
          "description": "Bottom edge.",
          "format": "double",
          "type": "number"
        },
        "coord_origin": {
          "$ref": "#/$defs/CoordOrigin",
          "description": "Corner `t` and `b` are measured from."
        },
        "l": {
          "description": "Left edge.",
          "format": "double",
          "type": "number"
        },
        "r": {
          "description": "Right edge.",
          "format": "double",
          "type": "number"
        },
        "t": {
          "description": "Top edge.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "l",
        "t",
        "r",
        "b",
        "coord_origin"
      ],
      "type": "object"
    },
    "CellRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive rectangular spreadsheet selection; the XLSX source locator.",
      "properties": {
        "column_end": {
          "description": "Last column, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "column_start": {
          "description": "First column, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_end": {
          "description": "Last row, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_start": {
          "description": "First row, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "sheet": {
          "description": "Exact sheet name.",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "row_start",
        "row_end",
        "column_start",
        "column_end"
      ],
      "type": "object"
    },
    "ConversionOutcome": {
      "description": "What the converter did; supplied text and corrections never change it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Accepted; the card was committed before conversion and shows no text.",
          "properties": {
            "status": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Docling's `Success`.",
          "properties": {
            "status": {
              "const": "completed",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Docling's `PartialSuccess`, or a windowed conversion with windows not converted.",
          "properties": {
            "coverage": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PageCoverage"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Pages converted and not converted; absent for a format docling converts whole."
            },
            "issues": {
              "description": "Why it is partial, as the converter recorded it.",
              "items": {
                "$ref": "#/$defs/ConverterIssue"
              },
              "type": "array"
            },
            "status": {
              "const": "partial",
              "type": "string"
            }
          },
          "required": [
            "status",
            "issues"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No document was produced.",
          "properties": {
            "issues": {
              "description": "What the converter recorded, when it recorded anything.",
              "items": {
                "$ref": "#/$defs/ConverterIssue"
              },
              "type": "array"
            },
            "reason": {
              "$ref": "#/$defs/FailureReason",
              "description": "Typed cause; never the converter's raw text alone."
            },
            "status": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason",
            "issues"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No converter handles this format (docling `UnknownFormat` or `UnsupportedFormat`).",
          "properties": {
            "status": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "ConversionSettings": {
      "additionalProperties": false,
      "description": "Converter settings; part of the identity of the digest they produce.\n\n`Default` is a Rust convenience for a deployment's defaults, never a serde default: every\nfield is required on the wire.",
      "properties": {
        "ocr": {
          "$ref": "#/$defs/OcrPolicy",
          "description": "When recognition runs."
        },
        "ocr_language": {
          "description": "Docling `ocr_lang`, such as `en` or `ch`; absent uses docling's default (`en`).",
          "type": [
            "string",
            "null"
          ]
        },
        "page_image_dpi": {
          "description": "Render resolution; docling `images_scale` = this / 72. At most 144, docling's own render\nresolution: a higher scale only upsamples that render and adds no detail.",
          "format": "uint16",
          "maximum": 144,
          "minimum": 36,
          "type": "integer"
        },
        "page_images": {
          "description": "Keep a render of every page (docling `generate_page_images`).",
          "type": "boolean"
        },
        "table_structure": {
          "description": "Reconstruct table structure with the model (docling `no_table_former` off).",
          "type": "boolean"
        }
      },
      "required": [
        "ocr",
        "table_structure",
        "page_images",
        "page_image_dpi"
      ],
      "type": "object"
    },
    "ConverterIdentity": {
      "additionalProperties": false,
      "description": "The converter that produced a digest; part of the digest's identity (SPEC section 4).",
      "properties": {
        "models": {
          "description": "Model files the pipeline loads, hashed once when the worker starts; empty for formats\nthat load none.",
          "items": {
            "$ref": "#/$defs/ModelIdentity"
          },
          "type": "array"
        },
        "name": {
          "description": "`docling`.",
          "type": "string"
        },
        "packages": {
          "description": "The converter crates as Cargo.lock resolves them; a patched fork is visible here.\nGenerated from Cargo.lock by xtask into `generated/converter/packages.json`, so\ngen-check holds it to the lock.",
          "items": {
            "$ref": "#/$defs/ConverterPackage"
          },
          "type": "array"
        },
        "page_window": {
          "description": "Pages per conversion window; absent when the document was converted whole.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "settings": {
          "$ref": "#/$defs/ConversionSettings",
          "description": "Settings applied."
        },
        "version": {
          "description": "The docling crate version, such as `2.3.0`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "packages",
        "settings",
        "models"
      ],
      "type": "object"
    },
    "ConverterIssue": {
      "additionalProperties": false,
      "description": "Docling's `ErrorItem`, with its own field names.",
      "properties": {
        "component_type": {
          "description": "`document_backend`, `model`, `doc_assembler` or `user_input`.",
          "type": "string"
        },
        "error_message": {
          "description": "The converter's message, with every worker filesystem path reduced to its file name.",
          "type": "string"
        },
        "module_name": {
          "description": "Stage that recorded it, such as `pipeline`.",
          "type": "string"
        }
      },
      "required": [
        "component_type",
        "module_name",
        "error_message"
      ],
      "type": "object"
    },
    "ConverterPackage": {
      "additionalProperties": false,
      "description": "One converter crate, as Cargo.lock records it.",
      "properties": {
        "name": {
          "description": "Crate name, such as `docling-pdf`.",
          "type": "string"
        },
        "source": {
          "description": "Cargo.lock `source`, such as `git+https://github.com/Heyoub/docling.rs?rev=...`.",
          "type": "string"
        },
        "version": {
          "description": "Crate version.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "source"
      ],
      "type": "object"
    },
    "CoordOrigin": {
      "description": "Docling's `coord_origin`: which corner `t` and `b` are measured from.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Docling `TOPLEFT`.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Docling `BOTTOMLEFT`.",
          "type": "string"
        }
      ]
    },
    "DeclaredOutcome": {
      "description": "What an OKF `sources` entry resolved to.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A citation of an item in this workspace at the resolved revision.",
          "properties": {
            "index": {
              "description": "Its position in `sources`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "cited",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Not a citation.",
          "properties": {
            "kind": {
              "const": "uncited",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UncitedReason",
              "description": "Why not."
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "DeclaredSource": {
      "additionalProperties": false,
      "description": "One entry of an item's OKF `sources` and what it resolved to.",
      "properties": {
        "entry": {
          "additionalProperties": true,
          "description": "The entry exactly as written in the file.",
          "type": "object"
        },
        "outcome": {
          "$ref": "#/$defs/DeclaredOutcome",
          "description": "Whether it is a citation of an item at the resolved revision."
        }
      },
      "required": [
        "entry",
        "outcome"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Extraction": {
      "additionalProperties": false,
      "description": "Everything recorded about turning one source occurrence's bytes into text.",
      "properties": {
        "converter": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConverterIdentity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present exactly when a converter ran (not for `pending` or `unsupported`)."
        },
        "corrected": {
          "description": "A human correction is shown over that text.",
          "type": "boolean"
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "The retained conversion record; present exactly when a document was produced\n(`completed`, `partial`)."
        },
        "outcome": {
          "$ref": "#/$defs/ConversionOutcome",
          "description": "What the converter did."
        },
        "page_count": {
          "description": "Pages in the original, for a paginated format.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "supplied": {
          "anyOf": [
            {
              "$ref": "#/$defs/SuppliedText"
            },
            {
              "type": "null"
            }
          ],
          "description": "The latest accepted agent-supplied text, shown or kept in history."
        },
        "text_origin": {
          "$ref": "#/$defs/TextOrigin",
          "description": "Whose text is shown."
        },
        "warnings": {
          "description": "Findings of the conversion.",
          "items": {
            "$ref": "#/$defs/ExtractionWarning"
          },
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "text_origin",
        "corrected",
        "warnings"
      ],
      "type": "object"
    },
    "ExtractionWarning": {
      "description": "Findings that leave a document usable but lessen what it says.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Glyphs the PDF's fonts give no Unicode for; detected, not recovered, never indexed as words.",
          "properties": {
            "kind": {
              "const": "undecodable_glyphs",
              "type": "string"
            },
            "pages": {
              "description": "Pages holding placeholders, ascending.",
              "items": {
                "$ref": "#/$defs/PageGlyphs"
              },
              "type": "array"
            },
            "unlocated_glyphs": {
              "description": "Placeholders in items that have no page.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "pages",
            "unlocated_glyphs"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Items located through the page text layer instead of by the converter.",
          "properties": {
            "items": {
              "description": "How many.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "inferred_locations",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Items with no location in the original.",
          "properties": {
            "items": {
              "description": "How many.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "unlocated_items",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A spreadsheet's cells were read as the values the file stores; formulas and number\nformats were not extracted (SPEC section 5 formula/value/format distinction).",
          "properties": {
            "kind": {
              "const": "cell_values_only",
              "type": "string"
            },
            "sheets": {
              "description": "Sheets read, in workbook order.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "sheets"
          ],
          "type": "object"
        }
      ]
    },
    "FailureReason": {
      "description": "Why a conversion produced no document.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The converter refused the bytes as unreadable: truncated, corrupt, or not what the\nname says (docling `Parse`, `WithSource`, or `Failure`).",
          "properties": {
            "kind": {
              "const": "damaged",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The worker reached its memory cap before any page converted.",
          "properties": {
            "kind": {
              "const": "memory_limit",
              "type": "string"
            },
            "limit_bytes": {
              "description": "The cap, in bytes, as a decimal string.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "limit_bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The worker's hard time bound ended it before any page converted.",
          "properties": {
            "kind": {
              "const": "time_limit",
              "type": "string"
            },
            "limit_seconds": {
              "description": "The bound, in whole seconds.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "limit_seconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The converter process ended abnormally (docling `Panic`, an abort, a signal).",
          "properties": {
            "kind": {
              "const": "converter_crashed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Any other converter error (docling `Io`, `Streaming`, `Browser`).",
          "properties": {
            "kind": {
              "const": "converter_error",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "description": "One model file of `docling::model_inventory()`, hashed by the worker at startup.",
      "properties": {
        "file": {
          "description": "File name only; never a filesystem path.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Digest",
          "description": "SHA-256 of the file as loaded."
        },
        "size": {
          "description": "Byte count as a decimal string.",
          "type": "string"
        },
        "stage": {
          "description": "Pipeline stage, such as `layout` or `ocr.rec`.",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "file",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "OcrPolicy": {
      "description": "When optical character recognition runs.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Recognise only regions with no embedded text layer (docling default).",
          "type": "string"
        },
        {
          "const": "skip",
          "description": "Never run recognition; layout and tables are still detected (docling `skip_ocr`).",
          "type": "string"
        },
        {
          "const": "force_full_page",
          "description": "Recognise every page from its render (docling `force_full_page_ocr`).",
          "type": "string"
        }
      ]
    },
    "PageCoverage": {
      "additionalProperties": false,
      "description": "Page by page coverage of a source converted in page windows (a PDF; an image is one page).\nFormats docling converts whole (Office, HTML) have no coverage.\n\nThe three lists are ascending, disjoint, and together cover exactly `1..=page_count`;\n`check` enforces it.",
      "properties": {
        "converted": {
          "description": "Pages converted with no known loss.",
          "items": {
            "$ref": "#/$defs/PageRange"
          },
          "type": "array"
        },
        "not_converted": {
          "description": "Pages with no extraction; a retry converts exactly these.",
          "items": {
            "$ref": "#/$defs/PageRange"
          },
          "type": "array"
        },
        "page_count": {
          "description": "Pages in the original.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "partly_extracted": {
          "description": "Pages converted whose text is partly undecodable (`ExtractionWarning::UndecodableGlyphs`).",
          "items": {
            "$ref": "#/$defs/PageRange"
          },
          "type": "array"
        }
      },
      "required": [
        "page_count",
        "converted",
        "partly_extracted",
        "not_converted"
      ],
      "type": "object"
    },
    "PageGlyphs": {
      "additionalProperties": false,
      "description": "Undecodable glyphs on one page.",
      "properties": {
        "glyphs": {
          "description": "Placeholders the library printed on that page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "page_no": {
          "description": "One-based page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "page_no",
        "glyphs"
      ],
      "type": "object"
    },
    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "PageRegion": {
      "additionalProperties": false,
      "description": "A box on one page, slide or image of the original.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox",
          "description": "The box."
        },
        "page_no": {
          "description": "One-based page or slide number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "page_size": {
          "$ref": "#/$defs/PageSize",
          "description": "The page's extent, so the box can be drawn over a page image on its own."
        }
      },
      "required": [
        "page_no",
        "bbox",
        "page_size"
      ],
      "type": "object"
    },
    "PageSize": {
      "additionalProperties": false,
      "description": "Extent of the page the box lies on, in the box's own unit (PDF points, image pixels, PPTX\nEMU). A reader draws the box over a page image by the ratio of the two, so it needs no unit.",
      "properties": {
        "height": {
          "description": "Page height.",
          "format": "double",
          "type": "number"
        },
        "width": {
          "description": "Page width.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "ProposalId": {
      "description": "Identity of a suggested change set, not a review.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Selection": {
      "description": "Explicit bounded source selection.\n\n`PartialEq` only: a `region` holds coordinates as `f64`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The complete source, subject to a visible response budget.",
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive line range.",
          "properties": {
            "kind": {
              "const": "lines",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/TextRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive page range.",
          "properties": {
            "kind": {
              "const": "pages",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/PageRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rectangular sheet range.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An unambiguous heading identifier.",
          "properties": {
            "heading": {
              "description": "Heading.",
              "type": "string"
            },
            "kind": {
              "const": "section",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "heading"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A box on one page: the extracted items whose location lies inside it; the `pages` view\nreturns that page's image.",
          "properties": {
            "kind": {
              "const": "region",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/PageRegion",
              "description": "Region."
            }
          },
          "required": [
            "kind",
            "region"
          ],
          "type": "object"
        }
      ]
    },
    "SourceAppearance": {
      "additionalProperties": false,
      "description": "One source occurrence; identical bytes do not imply identical meaning.",
      "properties": {
        "extraction": {
          "$ref": "#/$defs/Extraction",
          "description": "Everything recorded about turning these bytes into text, converter identity included."
        },
        "media_type": {
          "description": "Sniffed MIME type.",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extracted metadata with original field names preserved.",
          "type": "object"
        },
        "names": {
          "description": "Observed aliases associated with this occurrence.",
          "items": {
            "$ref": "#/$defs/SourceName"
          },
          "type": "array"
        },
        "object": {
          "$ref": "#/$defs/Digest",
          "description": "Immutable object content hash."
        },
        "parent_item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Container or message parent."
        },
        "size": {
          "description": "Decimal byte count.",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit successor relationship; not inferred from arrival time."
        }
      },
      "required": [
        "object",
        "names",
        "media_type",
        "size",
        "metadata",
        "extraction"
      ],
      "type": "object"
    },
    "SourceLocation": {
      "description": "A location and how it was obtained; an inferred location is a different variant from a\ndirect one, so no consumer can show it as direct by accident.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "From the converter's own provenance.",
          "properties": {
            "locator": {
              "$ref": "#/$defs/SourceLocator",
              "description": "Where."
            },
            "provenance": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "locator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Found by matching text against the page text layer (ingest-locates-unlocated-items).",
          "properties": {
            "locator": {
              "$ref": "#/$defs/SourceLocator",
              "description": "Where."
            },
            "provenance": {
              "const": "inferred",
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "locator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Not known; never given a guessed box.",
          "properties": {
            "provenance": {
              "const": "unresolved",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UnresolvedReason",
              "description": "Why."
            }
          },
          "required": [
            "provenance",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "SourceLocator": {
      "description": "Where in the original bytes something is.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A whole page or slide.",
          "properties": {
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page_no": {
              "description": "One-based page or slide number.",
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "page_no"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A box on a page, slide or image.",
          "properties": {
            "kind": {
              "const": "region",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/PageRegion",
              "description": "The box."
            }
          },
          "required": [
            "kind",
            "region"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Spreadsheet cells.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Sheet and one-based inclusive cell range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        }
      ]
    },
    "SourceName": {
      "additionalProperties": false,
      "description": "An observed source name and location; not an authority assertion.",
      "properties": {
        "filename": {
          "description": "Original supplied filename.",
          "type": "string"
        },
        "folder": {
          "description": "Original relative location.",
          "type": "string"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Observation time."
        },
        "supplied_by": {
          "description": "Server-recorded source identity.",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "folder",
        "observed_at",
        "supplied_by"
      ],
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "A precise citation that can be reopened independently of current state.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact derived artifact hash."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable application item identity; paths remain the portable OKF identity."
        },
        "locations": {
          "description": "Where the cited selection of the digest lies in the original, one entry per located\nitem it covers, in reading order.\n\nThe server computes it from (item, revision, digest, selection). A response always\nfills it. In a request an omitted list means \"fill it\"; a present list must equal what\nthe server computes, or the request is `invalid_input` on `.../locations`, so a caller\nnever supplies a location. A saved View file does not keep locations: they are derived,\nand the server fills them when it returns the View.",
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "type": "array"
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Relative path at the resolved source revision."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved source revision."
        },
        "selection": {
          "$ref": "#/$defs/Selection",
          "description": "Resolved page, lines, cells, region, section, or entire source."
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Workspace whose permissions and storage scope apply."
        }
      },
      "required": [
        "workspace_id",
        "item_id",
        "path",
        "revision",
        "selection"
      ],
      "type": "object"
    },
    "SuppliedText": {
      "additionalProperties": false,
      "description": "Accepted agent-supplied text of one source.",
      "properties": {
        "approved_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When it was accepted."
        },
        "approved_by": {
          "description": "Subject who accepted the proposal.",
          "type": "string"
        },
        "client_id": {
          "description": "OAuth or connector client it came through.",
          "type": [
            "string",
            "null"
          ]
        },
        "content_digest": {
          "$ref": "#/$defs/Digest",
          "description": "SHA-256 of the supplied Markdown."
        },
        "kept_by": {
          "description": "Who chose this text over a later complete conversion.",
          "type": [
            "string",
            "null"
          ]
        },
        "pages": {
          "description": "Pages the agent says the text covers: a claim, never a location; empty for the whole.",
          "items": {
            "$ref": "#/$defs/PageRange"
          },
          "type": "array"
        },
        "proposal_id": {
          "$ref": "#/$defs/ProposalId",
          "description": "The accepted proposal."
        },
        "supplied_by": {
          "description": "Subject of the agent that proposed it, recorded by the server.",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "supplied_by",
        "approved_by",
        "approved_at",
        "content_digest",
        "pages"
      ],
      "type": "object"
    },
    "TextOrigin": {
      "description": "Whose text a source card shows and search indexes.",
      "oneOf": [
        {
          "const": "converter",
          "description": "The converter's extraction.",
          "type": "string"
        },
        {
          "const": "supplied_by_agent",
          "description": "Text an agent proposed and a person accepted.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No text: pending, failed or unsupported, with nothing supplied.",
          "type": "string"
        }
      ]
    },
    "TextRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive line range.",
      "properties": {
        "end": {
          "description": "Last line, at least start.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First line, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "UncitedReason": {
      "description": "Why an OKF `sources` entry is not a citation.",
      "oneOf": [
        {
          "const": "external",
          "description": "A URL outside the workspace.",
          "type": "string"
        },
        {
          "const": "scope",
          "description": "A scope (a folder or a pattern) rather than one item.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "A workspace path that names no item at the resolved revision.",
          "type": "string"
        },
        {
          "const": "malformed",
          "description": "An entry with no `resource`.",
          "type": "string"
        }
      ]
    },
    "UnresolvedReason": {
      "description": "Why a location is not known; one variant per reason the producing rule states.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The format has no page geometry (DOCX, HTML, Markdown).",
          "properties": {
            "kind": {
              "const": "format_has_no_locator",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The converter gave this item no location and no rule locates it (PPTX, XLSX).",
          "properties": {
            "kind": {
              "const": "not_located_by_converter",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The page text layer could not be read.",
          "properties": {
            "kind": {
              "const": "no_text_layer",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A table or picture: there is no text to look up.",
          "properties": {
            "kind": {
              "const": "no_text_to_match",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Neither the parent nor an earlier sibling is located.",
          "properties": {
            "kind": {
              "const": "no_page_to_search",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No text-layer item on the searched pages has exactly this text.",
          "properties": {
            "kind": {
              "const": "no_match",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Several text-layer items have exactly this text.",
          "properties": {
            "kind": {
              "const": "ambiguous_match",
              "type": "string"
            },
            "occurrences": {
              "description": "How many.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "occurrences"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The one match has no area or lies outside the page.",
          "properties": {
            "kind": {
              "const": "match_not_a_location",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The cited text is a human correction, which has no place in the original.",
          "properties": {
            "kind": {
              "const": "corrected_text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The cited text was supplied by an agent; its page claims are not locations.",
          "properties": {
            "kind": {
              "const": "supplied_text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^/\\\\:<>\"|?*\\x00-\\x1f]+(/[^/\\\\:<>\"|?*\\x00-\\x1f]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Citations and source appearances for the selected item.",
  "properties": {
    "appearance": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAppearance"
        },
        {
          "type": "null"
        }
      ],
      "description": "Occurrence metadata if the item is a source."
    },
    "declared": {
      "description": "Every entry of the item's OKF `sources`, in the file's order, each exactly as written\n(its `id`, the key a footnote cites, and every other field kept) with what it resolved to;\nso no declared source, and none of its fields, is silently dropped.",
      "items": {
        "$ref": "#/$defs/DeclaredSource"
      },
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/Revision",
      "description": "Resolved version."
    },
    "sources": {
      "description": "Supporting citations.",
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "type": "array"
    }
  },
  "required": [
    "revision",
    "sources"
  ],
  "title": "GetSourcesResponse",
  "type": "object"
}
