{
  "$defs": {
    "At": {
      "description": "A requested version selector; resolved responses contain a `Revision` instead.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Resolve the current accepted workspace head exactly once.",
          "properties": {
            "kind": {
              "const": "latest",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Read an explicitly identified historical snapshot.",
          "properties": {
            "kind": {
              "const": "revision",
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/Revision",
              "description": "Exact resolved commit identity."
            }
          },
          "required": [
            "kind",
            "revision"
          ],
          "type": "object"
        }
      ]
    },
    "CellRange": {
      "additionalProperties": false,
      "description": "A one-based rectangular spreadsheet selection.",
      "properties": {
        "column_end": {
          "description": "Last column, inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "column_start": {
          "description": "First column, inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "row_end": {
          "description": "Last row, inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "row_start": {
          "description": "First row, inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sheet": {
          "description": "Exact sheet name.",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "row_start",
        "row_end",
        "column_start",
        "column_end"
      ],
      "type": "object"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "ReadView": {
      "description": "Select a representation rather than silently truncating a source.",
      "oneOf": [
        {
          "const": "outline",
          "description": "Headings, pages, and media descriptions.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Structured Markdown and source locators.",
          "type": "string"
        },
        {
          "const": "multimodal",
          "description": "Markdown and selected images.",
          "type": "string"
        },
        {
          "const": "pages",
          "description": "Selected rendered page images.",
          "type": "string"
        },
        {
          "const": "original",
          "description": "Authorized access to original bytes.",
          "type": "string"
        }
      ]
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Selection": {
      "description": "Explicit bounded source selection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The complete source, subject to a visible response budget.",
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive line range.",
          "properties": {
            "kind": {
              "const": "lines",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/TextRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive page range.",
          "properties": {
            "kind": {
              "const": "pages",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/PageRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rectangular sheet range.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An unambiguous heading identifier.",
          "properties": {
            "heading": {
              "description": "Heading.",
              "type": "string"
            },
            "kind": {
              "const": "section",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "heading"
          ],
          "type": "object"
        }
      ]
    },
    "TextRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive line range.",
      "properties": {
        "end": {
          "description": "Last line, at least start.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First line, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read an item using an explicit representation and a single revision resolution.",
  "properties": {
    "at": {
      "$ref": "#/$defs/At",
      "description": "Requested revision selector; latest is resolved once before reading."
    },
    "cursor": {
      "description": "Opaque continuation tied to revision and representation.",
      "type": [
        "string",
        "null"
      ]
    },
    "item_id": {
      "$ref": "#/$defs/ItemId",
      "description": "Stable application item identity; paths remain the portable OKF identity."
    },
    "max_bytes": {
      "description": "Response text budget; partial reads are marked and have continuation.",
      "format": "uint32",
      "maximum": 1048576,
      "minimum": 256,
      "type": "integer"
    },
    "max_images": {
      "description": "Maximum selected images.",
      "format": "uint16",
      "maximum": 16,
      "minimum": 0,
      "type": "integer"
    },
    "selection": {
      "$ref": "#/$defs/Selection",
      "description": "Section, range, or full source."
    },
    "view": {
      "$ref": "#/$defs/ReadView",
      "description": "Requested representation."
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "workspace_id",
    "item_id",
    "at",
    "view",
    "selection",
    "max_bytes",
    "max_images"
  ],
  "title": "ReadItemRequest",
  "type": "object"
}
