{
  "$defs": {
    "IdempotencyKey": {
      "description": "Caller-chosen retry identity for one write, scoped to tenant, subject and operation.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Permanently remove a workspace.",
  "properties": {
    "base_revision": {
      "$ref": "#/$defs/Revision",
      "description": "Exact revision on which this purge is based; a moved head conflicts."
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey",
      "description": "Retry identity."
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace to remove."
    }
  },
  "required": [
    "workspace_id",
    "base_revision",
    "idempotency_key"
  ],
  "title": "PurgeWorkspaceRequest",
  "type": "object"
}
