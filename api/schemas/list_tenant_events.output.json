{
  "$defs": {
    "AccessRoute": {
      "description": "How authenticated authority reached the application.\n\nLocal and hosted entry paths both resolve to one of these routes and share the same\nauthorization rules; no route is granted authority because the connection is loopback.",
      "oneOf": [
        {
          "const": "browser_session",
          "description": "Hosted Explorer session established through WorkOS AuthKit.",
          "type": "string"
        },
        {
          "const": "mcp_delegation",
          "description": "External agent: a WorkOS Connect token when hosted, a local connector credential when local.",
          "type": "string"
        },
        {
          "const": "local_owner",
          "description": "The installation-local owner identity, authenticated through the local browser session.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "Configured internal service identity.",
          "type": "string"
        }
      ]
    },
    "ConnectorId": {
      "description": "Identity of one local MCP connector credential, never the owner's browser session.",
      "format": "uuid",
      "type": "string"
    },
    "Event": {
      "additionalProperties": false,
      "description": "A resumable change notification, not canonical content.\n\nA tenant-level event (a sign-in, a connector issued or revoked, a refusal outside a\nworkspace) has no `workspace_id`. Security events carry their `actor`.",
      "properties": {
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventActor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who caused it; present on security events."
        },
        "at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the store recorded it."
        },
        "connector_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectorId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected connector."
        },
        "id": {
          "description": "Opaque monotonic event cursor.",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected item."
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected job."
        },
        "kind": {
          "$ref": "#/$defs/EventKind",
          "description": "What changed."
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationName"
            },
            {
              "type": "null"
            }
          ],
          "description": "The refused operation of a `permission_denied` event."
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content revision when applicable."
        },
        "workspace_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Workspace whose permissions and storage scope apply; absent for a tenant-level event."
        }
      },
      "required": [
        "id",
        "kind",
        "at"
      ],
      "type": "object"
    },
    "EventActor": {
      "additionalProperties": false,
      "description": "Who caused a security event.",
      "properties": {
        "client_id": {
          "description": "OAuth or connector client.",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "$ref": "#/$defs/AccessRoute",
          "description": "Route it came by."
        },
        "subject": {
          "description": "Authenticated subject.",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "route"
      ],
      "type": "object"
    },
    "EventKind": {
      "description": "Kinds of workspace change notification.",
      "oneOf": [
        {
          "const": "changed",
          "description": "Committed content changed.",
          "type": "string"
        },
        {
          "const": "imported",
          "description": "An import produced items.",
          "type": "string"
        },
        {
          "const": "job_updated",
          "description": "A job's durable state changed.",
          "type": "string"
        },
        {
          "const": "reviewed",
          "description": "A review was recorded.",
          "type": "string"
        },
        {
          "const": "proposal_updated",
          "description": "A proposal's state or discussion changed.",
          "type": "string"
        },
        {
          "const": "connector_issued",
          "description": "A local connector credential was issued (tenant-level).",
          "type": "string"
        },
        {
          "const": "connector_revoked",
          "description": "A local connector credential was revoked (tenant-level).",
          "type": "string"
        },
        {
          "const": "signed_in",
          "description": "A browser session began (tenant-level).",
          "type": "string"
        },
        {
          "const": "permission_denied",
          "description": "An authenticated request was refused for lack of a grant or by its route.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "JobId": {
      "description": "Durable background work identity retained across retries.",
      "format": "uuid",
      "type": "string"
    },
    "OperationName": {
      "description": "Closed set of canonical operation identifiers, serialized as the `snake_case` id.",
