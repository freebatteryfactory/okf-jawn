  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded change notifications.",
  "properties": {
    "events": {
      "description": "New notifications.",
      "items": {
        "$ref": "#/$defs/Event"
      },
      "type": "array"
    },
    "next_cursor": {
      "description": "Continuation cursor.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "events"
  ],
  "title": "ListEventsResponse",
