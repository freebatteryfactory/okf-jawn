{
  "$defs": {
    "Permission": {
      "description": "Application capabilities checked on every operation.",
      "oneOf": [
        {
          "const": "read",
          "description": "Read authorized workspace data.",
          "type": "string"
        },
        {
          "const": "write",
          "description": "Edit authorized workspace content.",
          "type": "string"
        },
        {
          "const": "propose",
          "description": "Create or update proposals without merging.",
          "type": "string"
        },
        {
          "const": "approve",
          "description": "Accept proposals at exact preconditions.",
          "type": "string"
        },
        {
          "const": "review",
          "description": "Record an explicit content review.",
          "type": "string"
        },
        {
          "const": "admin",
          "description": "Manage deployment or workspace access.",
          "type": "string"
        }
      ]
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Workspace": {
      "additionalProperties": false,
      "description": "A user-owned OKF workspace with a resolved head revision.",
      "properties": {
        "created_at": {
          "description": "RFC 3339 creation time.",
          "type": "string"
        },
        "description": {
          "description": "One-line context for people and agents.",
          "type": "string"
        },
        "head": {
          "$ref": "#/$defs/Revision",
          "description": "Current resolved Git commit."
        },
        "id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Stable application identity."
        },
        "name": {
          "description": "Human-selected workspace name.",
          "type": "string"
        },
        "permissions": {
          "description": "The caller's effective grant on this workspace after any delegation ceiling.",
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "head",
        "created_at",
        "permissions"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A bounded workspace listing.",
  "properties": {
    "items": {
      "description": "Authorized workspaces.",
      "items": {
        "$ref": "#/$defs/Workspace"
      },
      "type": "array"
    },
    "next_cursor": {
      "description": "Continuation cursor.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items"
  ],
  "title": "ListWorkspacesResponse",
  "type": "object"
}
