{
  "$defs": {
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "TypeDefinition": {
      "additionalProperties": false,
      "description": "A user-defined type schema and UI hints.",
      "properties": {
        "name": {
          "description": "Exact user-facing OKF type name.",
          "type": "string"
        },
        "properties_schema": {
          "description": "JSON Schema for type-specific properties."
        },
        "schema_version": {
          "description": "Application format version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ui_schema": {
          "description": "Presentation hints; never authorization rules."
        }
      },
      "required": [
        "name",
        "schema_version",
        "properties_schema",
        "ui_schema"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Save a type definition without discarding existing extension properties.",
  "properties": {
    "base_revision": {
      "$ref": "#/$defs/Revision",
      "description": "Exact revision on which this change is based; stale writes conflict."
    },
    "definition": {
      "$ref": "#/$defs/TypeDefinition",
      "description": "Validated property schema and UI hints."
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "workspace_id",
    "base_revision",
    "definition"
  ],
  "title": "SetTypeRequest",
  "type": "object"
}
