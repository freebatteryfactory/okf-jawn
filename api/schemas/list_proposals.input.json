{
  "$defs": {
    "PageRequest": {
      "additionalProperties": false,
      "description": "A bounded page request; the cursor is opaque and scoped to the query.",
      "properties": {
        "cursor": {
          "description": "Opaque continuation cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "description": "Maximum results requested; server may return fewer.",
          "format": "uint16",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "limit"
      ],
      "type": "object"
    },
    "ProposalStatus": {
      "description": "Lifecycle of a suggestion, not approval of a fact in it.",
      "oneOf": [
        {
          "const": "open",
          "description": "Available for review.",
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "Merged by an authorized action.",
          "type": "string"
        },
        {
          "const": "declined",
          "description": "Closed without applying changes.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Base state changed; reconciliation required.",
          "type": "string"
        }
      ]
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "List suggestions for an authorized workspace.",
  "properties": {
    "page": {
      "$ref": "#/$defs/PageRequest",
      "description": "Bounded pagination with an opaque cursor."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "State filter."
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "workspace_id",
    "page"
  ],
  "title": "ListProposalsRequest",
  "type": "object"
}
