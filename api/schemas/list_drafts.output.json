{
  "$defs": {
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Draft": {
      "additionalProperties": false,
      "description": "Saved draft metadata; one per (item, editor), and never a revision.",
      "properties": {
        "base_revision": {
          "$ref": "#/$defs/Revision",
          "description": "Head revision the draft is based on; a Snapshot conflicts if the item changed since."
        },
        "content_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the drafted body and properties."
        },
        "editor": {
          "description": "Server-established subject who owns this draft.",
          "type": "string"
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Drafted item."
        },
        "saved_at": {
          "description": "RFC 3339 time of the latest save.",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "editor",
        "base_revision",
        "content_digest",
        "saved_at"
      ],
      "type": "object"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The caller's drafts, without other editors' drafts.",
  "properties": {
    "items": {
      "description": "Draft metadata.",
      "items": {
        "$ref": "#/$defs/Draft"
      },
      "type": "array"
    },
    "next_cursor": {
      "description": "Continuation cursor.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items"
  ],
  "title": "ListDraftsResponse",
  "type": "object"
}
