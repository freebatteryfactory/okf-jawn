{
  "$defs": {
    "ConfirmationId": {
      "description": "Identity of one session-bound human confirmation challenge.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A short-lived challenge; issuance alone is not a review.",
  "properties": {
    "expires_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Expiration."
    },
    "id": {
      "$ref": "#/$defs/ConfirmationId",
      "description": "Opaque session-bound challenge."
    },
    "revision": {
      "$ref": "#/$defs/Revision",
      "description": "Bound revision."
    }
  },
  "required": [
    "id",
    "expires_at",
    "revision"
  ],
  "title": "Confirmation",
  "type": "object"
}
