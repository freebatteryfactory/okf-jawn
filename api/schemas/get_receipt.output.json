    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "ReceiptAudience": {
      "description": "Where returned content went; the two are distinct evidence.",
      "oneOf": [
        {
          "const": "agent_context",
          "description": "Supplied to an agent's context through a tool result.",
          "type": "string"
        },
        {
          "const": "human_display",
          "description": "Shown to a person in the workspace.",
          "type": "string"
        }
      ]
    },
    "ReceiptId": {
      "description": "Identity of a durable application operation record.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Selection": {
      "description": "Explicit bounded source selection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The complete source, subject to a visible response budget.",
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive line range.",
          "properties": {
            "kind": {
              "const": "lines",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/TextRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive page range.",
          "properties": {
            "kind": {
              "const": "pages",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/PageRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rectangular sheet range.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An unambiguous heading identifier.",
          "properties": {
            "heading": {
              "description": "Heading.",
              "type": "string"
            },
            "kind": {
              "const": "section",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "heading"
          ],
          "type": "object"
        }
      ]
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "A precise citation that can be reopened independently of current state.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact derived artifact hash."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable application item identity; paths remain the portable OKF identity."
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Relative path at the resolved source revision."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved source revision."
        },
        "selection": {
          "$ref": "#/$defs/Selection",
          "description": "Resolved page, lines, cells, section, or entire source."
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Workspace whose permissions and storage scope apply."
        }
      },
      "required": [
        "workspace_id",
        "item_id",
        "path",
        "revision",
        "selection"
      ],
      "type": "object"
    },
    "TextRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive line range.",
      "properties": {
        "end": {
          "description": "Last line, at least start.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First line, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^/\\\\:\\x00-\\x1f]+(/[^/\\\\:\\x00-\\x1f]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What this application returned, not what an external model retained.",
  "properties": {
    "audience": {
      "$ref": "#/$defs/ReceiptAudience",
      "description": "Agent context or human display; these are distinct."
    },
    "id": {
      "$ref": "#/$defs/ReceiptId",
      "description": "Durable operation record."
    },
    "operation_id": {
      "$ref": "#/$defs/OperationName",
      "description": "Canonical operation identifier."
    },
    "principal_subject": {
      "description": "Authenticated acting principal.",
      "type": "string"
    },
    "returned_at": {
      "description": "RFC 3339 response time.",
      "type": "string"
    },
    "route": {
      "$ref": "#/$defs/AccessRoute",
      "description": "Interface route."
    },
    "sources": {
      "description": "Exact returned source selections.",
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "type": "array"
    },
    "trace_id": {
      "description": "Optional diagnostic trace reference.",
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "id",
    "workspace_id",
    "operation_id",
    "principal_subject",
    "route",
    "sources",
    "returned_at",
    "audience"
  ],
  "title": "Receipt",
  "type": "object"
}
