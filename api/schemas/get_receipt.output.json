{
  "$defs": {
    "AccessRoute": {
      "description": "How authenticated authority reached the application.\n\nLocal and hosted entry paths both resolve to one of these routes and share the same\nauthorization rules; no route is granted authority because the connection is loopback.",
      "oneOf": [
        {
          "const": "browser_session",
          "description": "Hosted Explorer session established through WorkOS AuthKit.",
          "type": "string"
        },
        {
          "const": "mcp_delegation",
          "description": "External agent: a WorkOS Connect token when hosted, a local connector credential when local.",
          "type": "string"
        },
        {
          "const": "local_owner",
          "description": "The installation-local owner identity, authenticated through the local browser session.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "Configured internal service identity.",
          "type": "string"
        }
      ]
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Docling's bounding box, copied as the converter gave it (rounded to two decimals).",
      "properties": {
        "b": {
          "description": "Bottom edge.",
          "format": "double",
          "type": "number"
        },
        "coord_origin": {
          "$ref": "#/$defs/CoordOrigin",
          "description": "Corner `t` and `b` are measured from."
        },
        "l": {
          "description": "Left edge.",
          "format": "double",
          "type": "number"
        },
        "r": {
          "description": "Right edge.",
          "format": "double",
          "type": "number"
        },
        "t": {
          "description": "Top edge.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "l",
        "t",
        "r",
        "b",
        "coord_origin"
      ],
      "type": "object"
    },
    "CellRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive rectangular spreadsheet selection; the XLSX source locator.",
      "properties": {
        "column_end": {
          "description": "Last column, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "column_start": {
          "description": "First column, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_end": {
          "description": "Last row, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_start": {
          "description": "First row, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "sheet": {
          "description": "Exact sheet name.",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "row_start",
        "row_end",
        "column_start",
        "column_end"
      ],
      "type": "object"
    },
    "CoordOrigin": {
      "description": "Docling's `coord_origin`: which corner `t` and `b` are measured from.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Docling `TOPLEFT`.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Docling `BOTTOMLEFT`.",
          "type": "string"
        }
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "OperationName": {
      "description": "Closed set of canonical operation identifiers, serialized as the `snake_case` id.",
      "oneOf": [
        {
          "const": "list_workspaces",
          "description": "The `list_workspaces` operation.",
