    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "PageRegion": {
      "additionalProperties": false,
      "description": "A box on one page, slide or image of the original.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox",
          "description": "The box."
        },
        "page_no": {
          "description": "One-based page or slide number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "page_size": {
          "$ref": "#/$defs/PageSize",
          "description": "The page's extent, so the box can be drawn over a page image on its own."
        }
      },
      "required": [
        "page_no",
        "bbox",
        "page_size"
      ],
      "type": "object"
    },
    "PageSize": {
      "additionalProperties": false,
      "description": "Extent of the page the box lies on, in the box's own unit (PDF points, image pixels, PPTX\nEMU). A reader draws the box over a page image by the ratio of the two, so it needs no unit.",
      "properties": {
        "height": {
          "description": "Page height.",
          "format": "double",
          "type": "number"
        },
        "width": {
          "description": "Page width.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "PurgeId": {
      "description": "Identity of one purge; its record outlives what it removed.",
      "format": "uuid",
      "type": "string"
    },
    "ReceiptAudience": {
      "description": "Where returned content went; the two are distinct evidence.",
      "oneOf": [
        {
          "const": "agent_context",
          "description": "Supplied to an agent's context through a tool result.",
          "type": "string"
        },
        {
          "const": "human_display",
          "description": "Shown to a person in the workspace.",
          "type": "string"
        }
      ]
    },
    "ReceiptId": {
      "description": "Identity of a durable application operation record.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Selection": {
      "description": "Explicit bounded source selection.\n\n`PartialEq` only: a `region` holds coordinates as `f64`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The complete source, subject to a visible response budget.",
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive line range.",
          "properties": {
            "kind": {
              "const": "lines",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/TextRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive page range.",
          "properties": {
            "kind": {
              "const": "pages",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/PageRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rectangular sheet range.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An unambiguous heading identifier.",
          "properties": {
            "heading": {
              "description": "Heading.",
              "type": "string"
            },
            "kind": {
              "const": "section",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "heading"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A box on one page: the extracted items whose location lies inside it; the `pages` view\nreturns that page's image.",
          "properties": {
            "kind": {
              "const": "region",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/PageRegion",
              "description": "Region."
            }
          },
          "required": [
            "kind",
            "region"
          ],
          "type": "object"
        }
      ]
    },
    "SourceLocation": {
      "description": "A location and how it was obtained; an inferred location is a different variant from a\ndirect one, so no consumer can show it as direct by accident.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "From the converter's own provenance.",
          "properties": {
            "locator": {
              "$ref": "#/$defs/SourceLocator",
              "description": "Where."
            },
            "provenance": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "locator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Found by matching text against the page text layer (ingest-locates-unlocated-items).",
          "properties": {
            "locator": {
              "$ref": "#/$defs/SourceLocator",
              "description": "Where."
            },
            "provenance": {
              "const": "inferred",
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "locator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Not known; never given a guessed box.",
          "properties": {
            "provenance": {
              "const": "unresolved",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UnresolvedReason",
              "description": "Why."
            }
          },
          "required": [
            "provenance",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "SourceLocator": {
      "description": "Where in the original bytes something is.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A whole page or slide.",
          "properties": {
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page_no": {
              "description": "One-based page or slide number.",
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "page_no"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A box on a page, slide or image.",
          "properties": {
            "kind": {
              "const": "region",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/PageRegion",
              "description": "The box."
            }
          },
          "required": [
            "kind",
            "region"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Spreadsheet cells.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Sheet and one-based inclusive cell range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        }
      ]
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "A precise citation that can be reopened independently of current state.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact derived artifact hash."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable application item identity; paths remain the portable OKF identity."
        },
        "locations": {
          "description": "Where the cited selection of the digest lies in the original, one entry per located\nitem it covers, in reading order.\n\nThe server computes it from (item, revision, digest, selection). A response always\nfills it. In a request an omitted list means \"fill it\"; a present list must equal what\nthe server computes, or the request is `invalid_input` on `.../locations`, so a caller\nnever supplies a location. A saved View file does not keep locations: they are derived,\nand the server fills them when it returns the View.",
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "type": "array"
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Relative path at the resolved source revision."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved source revision."
        },
        "selection": {
          "$ref": "#/$defs/Selection",
          "description": "Resolved page, lines, cells, region, section, or entire source."
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Workspace whose permissions and storage scope apply."
        }
      },
      "required": [
        "workspace_id",
        "item_id",
        "path",
        "revision",
        "selection"
      ],
      "type": "object"
    },
    "TextRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive line range.",
      "properties": {
        "end": {
          "description": "Last line, at least start.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First line, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "UnresolvedReason": {
      "description": "Why a location is not known; one variant per reason the producing rule states.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The format has no page geometry (DOCX, HTML, Markdown).",
          "properties": {
            "kind": {
              "const": "format_has_no_locator",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The converter gave this item no location and no rule locates it (PPTX, XLSX).",
          "properties": {
            "kind": {
              "const": "not_located_by_converter",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The page text layer could not be read.",
          "properties": {
            "kind": {
              "const": "no_text_layer",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A table or picture: there is no text to look up.",
          "properties": {
            "kind": {
              "const": "no_text_to_match",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Neither the parent nor an earlier sibling is located.",
          "properties": {
            "kind": {
              "const": "no_page_to_search",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No text-layer item on the searched pages has exactly this text.",
          "properties": {
            "kind": {
              "const": "no_match",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Several text-layer items have exactly this text.",
          "properties": {
            "kind": {
              "const": "ambiguous_match",
              "type": "string"
            },
            "occurrences": {
              "description": "How many.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "occurrences"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The one match has no area or lies outside the page.",
          "properties": {
            "kind": {
              "const": "match_not_a_location",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The cited text is a human correction, which has no place in the original.",
          "properties": {
            "kind": {
              "const": "corrected_text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The cited text was supplied by an agent; its page claims are not locations.",
          "properties": {
            "kind": {
              "const": "supplied_text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^/\\\\:<>\"|?*\\x00-\\x1f]+(/[^/\\\\:<>\"|?*\\x00-\\x1f]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What this application returned, not what an external model retained.",
  "properties": {
    "audience": {
      "$ref": "#/$defs/ReceiptAudience",
      "description": "Agent context or human display; these are distinct."
    },
    "id": {
      "$ref": "#/$defs/ReceiptId",
      "description": "Durable operation record."
    },
    "invalidated_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/PurgeId"
        },
        {
          "type": "null"
        }
      ],
      "description": "The purge that invalidated a source this receipt cites; its stored path was scrubbed."
    },
    "operation_id": {
      "$ref": "#/$defs/OperationName",
      "description": "Canonical operation identifier."
    },
    "principal_subject": {
      "description": "Authenticated acting principal.",
      "type": "string"
    },
    "returned_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Response time."
    },
    "route": {
      "$ref": "#/$defs/AccessRoute",
      "description": "Interface route."
    },
    "sources": {
      "description": "Exact returned source selections.",
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "type": "array"
    },
    "trace_id": {
      "description": "Optional diagnostic trace reference.",
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "id",
    "workspace_id",
    "operation_id",
    "principal_subject",
    "route",
    "sources",
    "returned_at",
    "audience"
  ],
  "title": "Receipt",
  "type": "object"
}
