{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "description": "A resumable workspace change notification, not canonical content.",
      "properties": {
        "id": {
          "description": "Opaque monotonic event cursor.",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected item."
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Affected job."
        },
        "kind": {
          "$ref": "#/$defs/EventKind",
          "description": "What changed."
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ],
          "description": "Content revision when applicable."
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Workspace whose permissions and storage scope apply."
        }
      },
      "required": [
        "id",
        "workspace_id",
        "kind"
      ],
      "type": "object"
    },
    "EventKind": {
      "description": "Kinds of workspace change notification.",
      "oneOf": [
        {
          "const": "changed",
          "description": "Committed content changed.",
          "type": "string"
        },
        {
          "const": "imported",
          "description": "An import produced items.",
          "type": "string"
        },
        {
          "const": "job_updated",
          "description": "A job's durable state changed.",
          "type": "string"
        },
        {
          "const": "reviewed",
          "description": "A review was recorded.",
          "type": "string"
        },
        {
          "const": "proposal_updated",
          "description": "A proposal's state or discussion changed.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "JobId": {
      "description": "Durable background work identity retained across retries.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded change notifications.",
  "properties": {
    "events": {
      "description": "New notifications.",
      "items": {
        "$ref": "#/$defs/Event"
      },
      "type": "array"
    },
    "next_cursor": {
      "description": "Continuation cursor.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "events"
  ],
  "title": "ListEventsResponse",
  "type": "object"
}
