{
  "$defs": {
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Prepare explicit human confirmation bound to an action and immutable target.",
  "properties": {
    "action": {
      "description": "review or `accept_proposal`; not an arbitrary method.",
      "type": "string"
    },
    "content_digest": {
      "$ref": "#/$defs/Digest",
      "description": "Displayed content digest."
    },
    "revision": {
      "$ref": "#/$defs/Revision",
      "description": "Displayed content revision."
    },
    "target_id": {
      "description": "Item or proposal identity.",
      "type": "string"
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "workspace_id",
    "action",
    "target_id",
    "revision",
    "content_digest"
  ],
  "title": "CreateConfirmationRequest",
  "type": "object"
}
