{
  "$defs": {
    "ConfirmationAction": {
      "description": "The explicit human action a confirmation authorizes; never an arbitrary method.",
      "oneOf": [
        {
          "const": "review",
          "description": "Record a content review; requires the review permission.",
          "type": "string"
        },
        {
          "const": "accept_proposal",
          "description": "Accept a proposal; requires the approve permission.",
          "type": "string"
        }
      ]
    },
    "ConfirmationTarget": {
      "description": "The immutable object a confirmation is bound to.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "An item revision being reviewed.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Reviewed item."
            },
            "kind": {
              "const": "item",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "item_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A proposal revision being accepted.",
          "properties": {
            "kind": {
              "const": "proposal",
              "type": "string"
            },
            "proposal_id": {
              "$ref": "#/$defs/ProposalId",
              "description": "Accepted proposal."
            }
          },
          "required": [
            "kind",
            "proposal_id"
          ],
          "type": "object"
        }
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "IdempotencyKey": {
      "description": "Caller-chosen retry identity for one write, scoped to tenant, subject and operation.",
      "format": "uuid",
      "type": "string"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "ProposalId": {
      "description": "Identity of a suggested change set, not a review.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Prepare explicit human confirmation bound to an action and immutable target.",
  "properties": {
    "action": {
      "$ref": "#/$defs/ConfirmationAction",
      "description": "Confirmed action; it determines the required permission."
    },
    "content_digest": {
      "$ref": "#/$defs/Digest",
      "description": "Displayed content digest."
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey",
      "description": "Retry identity."
    },
    "revision": {
      "$ref": "#/$defs/Revision",
      "description": "Displayed content revision."
    },
    "target": {
      "$ref": "#/$defs/ConfirmationTarget",
      "description": "Item or proposal being confirmed."
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "workspace_id",
    "action",
    "target",
    "revision",
    "content_digest",
    "idempotency_key"
  ],
  "title": "CreateConfirmationRequest",
  "type": "object"
}
