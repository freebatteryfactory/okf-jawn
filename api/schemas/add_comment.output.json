{
  "$defs": {
    "PurgeId": {
      "description": "Identity of one purge; its record outlives what it removed.",
      "format": "uuid",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A server-attributed discussion entry.",
  "properties": {
    "author": {
      "description": "Authenticated subject.",
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp",
      "description": "Creation time."
    },
    "id": {
      "description": "Comment identity.",
      "type": "string"
    },
    "invalidated_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/PurgeId"
        },
        {
          "type": "null"
        }
      ],
      "description": "The purge that invalidated the comment's `source`, whose stored path was scrubbed."
    },
    "text": {
      "description": "Discussion text.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "author",
    "text",
    "created_at"
  ],
  "title": "Comment",
  "type": "object"
}
