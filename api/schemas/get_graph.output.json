{
  "$defs": {
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "ItemKind": {
      "description": "Built-in presentation roles; user-defined OKF type names remain unrestricted.",
      "oneOf": [
        {
          "const": "note",
          "description": "Human or agent-authored Markdown knowledge.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "An appearance of immutable source bytes.",
          "type": "string"
        },
        {
          "const": "view",
          "description": "A source-bound declarative visual artifact.",
          "type": "string"
        }
      ]
    },
    "ItemSummary": {
      "additionalProperties": false,
      "description": "A navigable item description bound to a resolved workspace revision.",
      "properties": {
        "description": {
          "description": "One-line navigation summary.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable identity."
        },
        "kind": {
          "$ref": "#/$defs/ItemKind",
          "description": "Built-in rendering role."
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle",
          "description": "Presentation lifecycle."
        },
        "media_type": {
          "description": "Original MIME type if there is a source object.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Current relative OKF path."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved revision for this summary."
        },
        "title": {
          "description": "Human-readable title.",
          "type": "string"
        },
        "type_name": {
          "description": "User-selected OKF type; not a closed enum.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "title",
        "description",
        "type_name",
        "kind",
        "revision",
        "lifecycle"
      ],
      "type": "object"
    },
    "Lifecycle": {
      "description": "Application lifecycle distinct from business approval.",
      "oneOf": [
        {
          "const": "active",
          "description": "Current and usable content.",
          "type": "string"
        },
        {
          "const": "deprecated",
          "description": "Retained historical content.",
          "type": "string"
        },
        {
          "const": "archived",
          "description": "Hidden from ordinary current listings; still retrievable.",
          "type": "string"
        }
      ]
    },
    "Link": {
      "additionalProperties": false,
      "description": "A source-level relationship between items.",
      "properties": {
        "from": {
          "$ref": "#/$defs/ItemId",
          "description": "Linking item."
        },
        "label": {
          "description": "Link label.",
          "type": "string"
        },
        "line": {
          "description": "Source line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved target, absent for broken links."
        },
        "to_path": {
          "description": "Target path as written.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to_path",
        "label",
        "line"
      ],
      "type": "object"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Graph nodes and edges from the same authorized revision.",
  "properties": {
    "edges": {
      "description": "Known links among selected items.",
      "items": {
        "$ref": "#/$defs/Link"
      },
      "type": "array"
    },
    "nodes": {
      "description": "Authorized items.",
      "items": {
        "$ref": "#/$defs/ItemSummary"
      },
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/Revision",
      "description": "Resolved revision."
    },
    "truncated": {
      "description": "The graph is partial due to budget.",
      "type": "boolean"
    }
  },
  "required": [
    "revision",
    "nodes",
    "edges",
    "truncated"
  ],
  "title": "GetGraphResponse",
  "type": "object"
}
