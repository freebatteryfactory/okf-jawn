{
  "$defs": {
    "ExtractionStatus": {
      "description": "The converter's verdict on one source, as a listing and a filter use it.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Accepted; no conversion has finished.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "Every page, or the whole non-paginated document, was converted.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "A document was produced but part of the source is missing from it.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The converter produced no document; the bytes are retained.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "No converter exists for this format; the bytes are retained.",
          "type": "string"
        }
      ]
    },
    "ExtractionSummary": {
      "additionalProperties": false,
      "description": "What a listing shows about one source.",
      "properties": {
        "corrected": {
          "description": "A human correction is shown over that text.",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ExtractionStatus",
          "description": "The converter's verdict."
        },
        "text_origin": {
          "$ref": "#/$defs/TextOrigin",
          "description": "Whose text is shown."
        }
      },
      "required": [
        "status",
        "text_origin",
        "corrected"
      ],
      "type": "object"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "ItemKind": {
      "description": "Built-in presentation roles; user-defined OKF type names remain unrestricted.",
      "oneOf": [
        {
          "const": "note",
          "description": "Human or agent-authored Markdown knowledge.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "An appearance of immutable source bytes.",
          "type": "string"
        },
        {
          "const": "view",
          "description": "A source-bound declarative visual artifact.",
          "type": "string"
        }
      ]
    },
    "ItemStatus": {
      "description": "OKF's `status` word of an item, distinct from business approval and from archiving.\n\nAn absent OKF `status` reads `stable`. `other` is a producer's value outside the three,\nkept exactly as written in the file's `status` property; it cannot be set through\n`set_lifecycle`.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Work in progress.",
          "type": "string"
        },
        {
          "const": "stable",
          "description": "Current and usable content.",
          "type": "string"
        },
        {
          "const": "deprecated",
          "description": "Retained, superseded content; still searchable.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A status word outside the three, preserved in the file.",
          "type": "string"
        }
      ]
    },
    "ItemSummary": {
      "additionalProperties": false,
      "description": "A navigable item description bound to a resolved workspace revision.",
      "properties": {
        "archived": {
          "description": "Hidden from ordinary current listings; reversible and keeps history.",
          "type": "boolean"
        },
        "description": {
          "description": "One-line navigation summary.",
          "type": "string"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionSummary"
            },
            {
              "type": "null"
            }
          ],
          "description": "The converter's verdict and whose text is shown; present exactly when `kind` is `source`."
        },
        "id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable identity."
        },
        "kind": {
          "$ref": "#/$defs/ItemKind",
          "description": "Built-in rendering role."
        },
        "media_type": {
          "description": "Original MIME type if there is a source object.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Current relative OKF path."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved revision for this summary."
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "description": "OKF status word."
        },
        "title": {
          "description": "Human-readable title.",
          "type": "string"
        },
        "type_name": {
          "description": "User-selected OKF type; not a closed enum.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "title",
        "description",
        "type_name",
        "kind",
        "revision",
        "status",
        "archived"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A source-level relationship between items.",
      "properties": {
        "from": {
          "$ref": "#/$defs/ItemId",
          "description": "Linking item."
        },
        "label": {
          "description": "Link label.",
          "type": "string"
        },
        "line": {
          "description": "Source line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolved target, absent for broken links."
        },
        "to_path": {
          "description": "Target path as written.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to_path",
        "label",
        "line"
      ],
      "type": "object"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "TextOrigin": {
      "description": "Whose text a source card shows and search indexes.",
      "oneOf": [
        {
          "const": "converter",
          "description": "The converter's extraction.",
          "type": "string"
        },
        {
          "const": "supplied_by_agent",
          "description": "Text an agent proposed and a person accepted.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No text: pending, failed or unsupported, with nothing supplied.",
          "type": "string"
        }
      ]
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^/\\\\:<>\"|?*\\x00-\\x1f]+(/[^/\\\\:<>\"|?*\\x00-\\x1f]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Graph nodes and edges from the same authorized revision.",
  "properties": {
    "edges": {
      "description": "Known links among selected items.",
      "items": {
        "$ref": "#/$defs/Link"
      },
      "type": "array"
    },
    "nodes": {
      "description": "Authorized items.",
      "items": {
        "$ref": "#/$defs/ItemSummary"
      },
      "type": "array"
    },
    "revision": {
      "$ref": "#/$defs/Revision",
      "description": "Resolved revision."
    },
    "truncated": {
      "description": "The graph is partial due to budget.",
      "type": "boolean"
    }
  },
  "required": [
    "revision",
    "nodes",
    "edges",
    "truncated"
  ],
  "title": "GetGraphResponse",
  "type": "object"
}
