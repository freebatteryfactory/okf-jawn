{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Docling's bounding box, copied as the converter gave it (rounded to two decimals).",
      "properties": {
        "b": {
          "description": "Bottom edge.",
          "format": "double",
          "type": "number"
        },
        "coord_origin": {
          "$ref": "#/$defs/CoordOrigin",
          "description": "Corner `t` and `b` are measured from."
        },
        "l": {
          "description": "Left edge.",
          "format": "double",
          "type": "number"
        },
        "r": {
          "description": "Right edge.",
          "format": "double",
          "type": "number"
        },
        "t": {
          "description": "Top edge.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "l",
        "t",
        "r",
        "b",
        "coord_origin"
      ],
      "type": "object"
    },
    "CellRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive rectangular spreadsheet selection; the XLSX source locator.",
      "properties": {
        "column_end": {
          "description": "Last column, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "column_start": {
          "description": "First column, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_end": {
          "description": "Last row, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_start": {
          "description": "First row, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "sheet": {
          "description": "Exact sheet name.",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "row_start",
        "row_end",
        "column_start",
        "column_end"
      ],
      "type": "object"
    },
    "CoordOrigin": {
      "description": "Docling's `coord_origin`: which corner `t` and `b` are measured from.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Docling `TOPLEFT`.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Docling `BOTTOMLEFT`.",
          "type": "string"
        }
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ImportedClaim": {
      "additionalProperties": false,
      "description": "An unconfirmed claim carried in an imported file's OKF `verified` value; never an app review.\n\nIt has no review identity, no authenticated reviewer and no confirmed content, and its\ncoverage is always `ReviewCoverage::Imported`.",
      "properties": {
        "at": {
          "description": "The claimed instant as written in the file, not normalized: it is the file's claim and\nnot a server instant.",
          "type": [
            "string",
            "null"
          ]
        },
        "by": {
          "description": "The claimed verifier as written in the file.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "PageRegion": {
      "additionalProperties": false,
      "description": "A box on one page, slide or image of the original.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox",
          "description": "The box."
        },
        "page_no": {
          "description": "One-based page or slide number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "page_size": {
          "$ref": "#/$defs/PageSize",
          "description": "The page's extent, so the box can be drawn over a page image on its own."
        }
      },
      "required": [
        "page_no",
        "bbox",
        "page_size"
      ],
      "type": "object"
    },
    "PageSize": {
      "additionalProperties": false,
      "description": "Extent of the page the box lies on, in the box's own unit (PDF points, image pixels, PPTX\nEMU). A reader draws the box over a page image by the ratio of the two, so it needs no unit.",
      "properties": {
        "height": {
          "description": "Page height.",
          "format": "double",
          "type": "number"
        },
        "width": {
          "description": "Page width.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "A review action linked to the content that was actually displayed.",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the exact reviewed text."
        },
        "coverage": {
          "$ref": "#/$defs/ReviewCoverage",
          "description": "Coverage relative to current content."
        },
        "id": {
          "$ref": "#/$defs/ReviewId",
          "description": "Durable review identity."
        },
        "reviewed_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Action time."
        },
        "reviewer_subject": {
          "description": "Server-established subject; not supplied in request.",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference",
          "description": "Reviewed revision and range."
        }
      },
      "required": [
        "id",
        "source",
        "content_digest",
        "reviewer_subject",
        "reviewed_at",
        "coverage"
      ],
      "type": "object"
    },
    "ReviewCoverage": {
      "description": "How recorded review evidence relates to current content.",
      "oneOf": [
        {
          "const": "current",
          "description": "The recorded content digest still matches.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "Content changed after this review.",
          "type": "string"
        },
        {
          "const": "imported",
          "description": "Describes a claim a file carries, never an app review: an imported file's OKF `verified`\nvalue has no authenticated in-app review event. It never appears on a recorded `Review`\ncreated by `create_review`.",
          "type": "string"
        },
        {
          "const": "unreviewed",
          "description": "No covering review exists.",
          "type": "string"
        },
        {
          "const": "invalidated",
          "description": "The reviewed content was purged; the review covers nothing that still exists.",
          "type": "string"
        }
      ]
    },
    "ReviewId": {
      "description": "Identity of an explicit revision-bound review action.",
      "format": "uuid",
      "type": "string"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Selection": {
      "description": "Explicit bounded source selection.\n\n`PartialEq` only: a `region` holds coordinates as `f64`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The complete source, subject to a visible response budget.",
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive line range.",
          "properties": {
            "kind": {
              "const": "lines",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/TextRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive page range.",
          "properties": {
            "kind": {
              "const": "pages",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/PageRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rectangular sheet range.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An unambiguous heading identifier.",
          "properties": {
            "heading": {
              "description": "Heading.",
              "type": "string"
            },
            "kind": {
              "const": "section",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "heading"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A box on one page: the extracted items whose location lies inside it; the `pages` view\nreturns that page's image.",
          "properties": {
            "kind": {
              "const": "region",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/PageRegion",
              "description": "Region."
            }
          },
          "required": [
            "kind",
            "region"
          ],
          "type": "object"
        }
      ]
    },
    "SourceLocation": {
      "description": "A location and how it was obtained; an inferred location is a different variant from a\ndirect one, so no consumer can show it as direct by accident.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "From the converter's own provenance.",
          "properties": {
            "locator": {
              "$ref": "#/$defs/SourceLocator",
              "description": "Where."
            },
            "provenance": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "locator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Found by matching text against the page text layer (ingest-locates-unlocated-items).",
          "properties": {
            "locator": {
              "$ref": "#/$defs/SourceLocator",
              "description": "Where."
            },
            "provenance": {
              "const": "inferred",
              "type": "string"
            }
          },
          "required": [
            "provenance",
            "locator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Not known; never given a guessed box.",
          "properties": {
            "provenance": {
              "const": "unresolved",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UnresolvedReason",
              "description": "Why."
            }
          },
          "required": [
            "provenance",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "SourceLocator": {
      "description": "Where in the original bytes something is.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A whole page or slide.",
          "properties": {
            "kind": {
              "const": "page",
              "type": "string"
            },
            "page_no": {
              "description": "One-based page or slide number.",
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "page_no"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A box on a page, slide or image.",
          "properties": {
            "kind": {
              "const": "region",
              "type": "string"
            },
            "region": {
              "$ref": "#/$defs/PageRegion",
              "description": "The box."
            }
          },
          "required": [
            "kind",
            "region"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Spreadsheet cells.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Sheet and one-based inclusive cell range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        }
      ]
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "A precise citation that can be reopened independently of current state.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact derived artifact hash."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable application item identity; paths remain the portable OKF identity."
        },
        "locations": {
          "description": "Where the cited selection of the digest lies in the original, one entry per located\nitem it covers, in reading order.\n\nThe server computes it from (item, revision, digest, selection). A response always\nfills it. In a request an omitted list means \"fill it\"; a present list must equal what\nthe server computes, or the request is `invalid_input` on `.../locations`, so a caller\nnever supplies a location. A saved View file does not keep locations: they are derived,\nand the server fills them when it returns the View.",
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "type": "array"
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Relative path at the resolved source revision."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved source revision."
        },
        "selection": {
          "$ref": "#/$defs/Selection",
          "description": "Resolved page, lines, cells, region, section, or entire source."
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Workspace whose permissions and storage scope apply."
        }
      },
      "required": [
        "workspace_id",
        "item_id",
        "path",
        "revision",
        "selection"
      ],
      "type": "object"
    },
    "TextRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive line range.",
      "properties": {
        "end": {
          "description": "Last line, at least start.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First line, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "UnresolvedReason": {
      "description": "Why a location is not known; one variant per reason the producing rule states.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The format has no page geometry (DOCX, HTML, Markdown).",
          "properties": {
            "kind": {
              "const": "format_has_no_locator",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The converter gave this item no location and no rule locates it (PPTX, XLSX).",
          "properties": {
            "kind": {
              "const": "not_located_by_converter",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The page text layer could not be read.",
          "properties": {
            "kind": {
              "const": "no_text_layer",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A table or picture: there is no text to look up.",
          "properties": {
            "kind": {
              "const": "no_text_to_match",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Neither the parent nor an earlier sibling is located.",
          "properties": {
            "kind": {
              "const": "no_page_to_search",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No text-layer item on the searched pages has exactly this text.",
          "properties": {
            "kind": {
              "const": "no_match",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Several text-layer items have exactly this text.",
          "properties": {
            "kind": {
              "const": "ambiguous_match",
              "type": "string"
            },
            "occurrences": {
              "description": "How many.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "occurrences"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The one match has no area or lies outside the page.",
          "properties": {
            "kind": {
              "const": "match_not_a_location",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The cited text is a human correction, which has no place in the original.",
          "properties": {
            "kind": {
              "const": "corrected_text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The cited text was supplied by an agent; its page claims are not locations.",
          "properties": {
            "kind": {
              "const": "supplied_text",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^/\\\\:<>\"|?*\\x00-\\x1f]+(/[^/\\\\:<>\"|?*\\x00-\\x1f]+)*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Recorded reviews and current coverage.",
  "properties": {
    "imported": {
      "description": "The item's imported claims at the resolved revision; empty when the file carries none.",
      "items": {
        "$ref": "#/$defs/ImportedClaim"
      },
      "type": "array"
    },
    "items": {
      "description": "Reviews, including non-current ones.",
      "items": {
        "$ref": "#/$defs/Review"
      },
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "ListReviewsResponse",
  "type": "object"
}
