{
  "$defs": {
    "CollisionPolicy": {
      "description": "How proposed naming collisions are handled.",
      "oneOf": [
        {
          "const": "reject",
          "description": "Require an explicit decision.",
          "type": "string"
        },
        {
          "const": "suffix",
          "description": "Add a deterministic suffix.",
          "type": "string"
        },
        {
          "const": "keep_existing",
          "description": "Keep the original name and report the collision.",
          "type": "string"
        }
      ]
    },
    "DateOrder": {
      "description": "Declared date interpretation; ambiguous input is not guessed.",
      "oneOf": [
        {
          "const": "ymd",
          "description": "Year, month, day.",
          "type": "string"
        },
        {
          "const": "mdy",
          "description": "Month, day, year.",
          "type": "string"
        },
        {
          "const": "dmy",
          "description": "Day, month, year.",
          "type": "string"
        },
        {
          "const": "reject_ambiguous",
          "description": "Require unambiguous dates or a human choice.",
          "type": "string"
        }
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "DuplicateObservation": {
      "additionalProperties": false,
      "description": "One path observed as a duplicate during rename preview.",
      "properties": {
        "item_ids": {
          "description": "Item identities that collide on that path.",
          "items": {
            "$ref": "#/$defs/ItemId"
          },
          "type": "array"
        },
        "message": {
          "description": "Human-readable observation without mutating content.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Path observed more than once."
        }
      },
      "required": [
        "path",
        "item_ids",
        "message"
      ],
      "type": "object"
    },
    "ExtensionPolicy": {
      "description": "How filename extensions are handled when applying a naming rule.",
      "oneOf": [
        {
          "const": "preserve",
          "description": "Leave the extension unchanged.",
          "type": "string"
        },
        {
          "const": "lowercase",
          "description": "Lower-case the extension.",
          "type": "string"
        },
        {
          "const": "strip",
          "description": "Drop the extension from the normalized note path (never from originals).",
          "type": "string"
        }
      ]
    },
    "IdempotencyKey": {
      "description": "Caller-chosen retry identity for one write, scoped to tenant, subject and operation.",
      "format": "uuid",
      "type": "string"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "LetterCase": {
      "description": "Supported case transformations.",
      "oneOf": [
        {
          "const": "preserve",
          "description": "Preserve case.",
          "type": "string"
        },
        {
          "const": "lower",
          "description": "Lower case.",
          "type": "string"
        },
        {
          "const": "upper",
          "description": "Upper case.",
          "type": "string"
        },
        {
          "const": "title",
          "description": "Title case.",
          "type": "string"
        },
        {
          "const": "snake",
          "description": "Snake case.",
          "type": "string"
        },
        {
          "const": "kebab",
          "description": "Kebab case.",
          "type": "string"
        }
      ]
    },
    "NamingRule": {
      "additionalProperties": false,
      "description": "A typed rule scoped by glob and optional OKF type.",
      "properties": {
        "alias_preservation": {
          "description": "When true, preserve existing path aliases while renaming the primary path.",
          "type": "boolean"
        },
        "case": {
          "$ref": "#/$defs/LetterCase",
          "description": "Case transformation."
        },
        "collision": {
          "$ref": "#/$defs/CollisionPolicy",
          "description": "Collision behavior."
        },
        "date_format": {
          "description": "Explicit output format.",
          "type": "string"
        },
        "date_order": {
          "$ref": "#/$defs/DateOrder",
          "description": "Declared incoming date convention."
        },
        "destination": {
          "description": "Relative destination template.",
          "type": [
            "string",
            "null"
          ]
        },
        "extension_policy": {
          "$ref": "#/$defs/ExtensionPolicy",
          "description": "How the filename extension is transformed on normalized notes."
        },
        "glob": {
          "description": "Match against the supplied relative path.",
          "type": "string"
        },
        "prefix": {
          "description": "Optional literal prefix.",
          "type": "string"
        },
        "separator": {
          "description": "Word separator.",
          "type": "string"
        },
        "strip_version_suffix": {
          "description": "Remove filename suffixes only from normalized notes, never originals.",
          "type": "boolean"
        },
        "suffix": {
          "description": "Optional literal suffix applied to the normalized base name.",
          "type": [
            "string",
            "null"
          ]
        },
        "type_name": {
          "description": "Optional OKF type selector.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "glob",
        "case",
        "separator",
        "prefix",
        "date_order",
        "date_format",
        "strip_version_suffix",
        "extension_policy",
        "alias_preservation",
        "collision"
      ],
      "type": "object"
    },
    "NamingRules": {
      "additionalProperties": false,
      "description": "Versioned naming rules rendered as a form and editable as YAML.",
      "properties": {
        "rules": {
          "description": "Rules applied in explicit list order.",
          "items": {
            "$ref": "#/$defs/NamingRule"
          },
          "type": "array"
        },
        "schema_version": {
          "description": "Format version; this release emits 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "rules"
      ],
      "type": "object"
    },
    "RenameEntry": {
      "additionalProperties": false,
      "description": "A proposed path change with an explanation.",
      "properties": {
        "from": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Current path."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable application item identity; paths remain the portable OKF identity."
        },
        "to": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Proposed path."
        },
        "warnings": {
          "description": "Ambiguity or collision details.",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "from",
        "to",
        "warnings"
      ],
      "type": "object"
    },
    "RenamePlan": {
      "additionalProperties": false,
      "description": "A preview bound to source state and exact conventions.",
      "properties": {
        "base_revision": {
          "$ref": "#/$defs/Revision",
          "description": "Workspace revision inspected."
        },
        "duplicate_observations": {
          "description": "Duplicate path observations recorded during preview.",
          "items": {
            "$ref": "#/$defs/DuplicateObservation"
          },
          "type": "array"
        },
        "entries": {
          "description": "Proposed changes.",
          "items": {
            "$ref": "#/$defs/RenameEntry"
          },
          "type": "array"
        },
        "rules_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Digest of the exact canonical rules."
        },
        "warnings": {
          "description": "Plan-level warnings.",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "type": "array"
        }
      },
      "required": [
        "base_revision",
        "rules_digest",
        "entries",
        "duplicate_observations",
        "warnings"
      ],
      "type": "object"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Warning": {
      "additionalProperties": false,
      "description": "A diagnostic that does not silently discard usable input.",
      "properties": {
        "code": {
          "description": "Stable diagnostic identifier.",
          "type": "string"
        },
        "location": {
          "description": "Page, cell, path, or field locator.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable explanation.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Stable application identity for one user-organized workspace.",
      "format": "uuid",
      "type": "string"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Apply a revision-bound preview and rewrite affected links.",
  "properties": {
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey",
      "description": "Retry identity."
    },
    "plan": {
      "$ref": "#/$defs/RenamePlan",
      "description": "Plan revalidated before any writes."
    },
    "rules": {
      "$ref": "#/$defs/NamingRules",
      "description": "Rules whose digest must match the preview."
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId",
      "description": "Workspace whose permissions and storage scope apply."
    }
  },
  "required": [
    "workspace_id",
    "plan",
    "rules",
    "idempotency_key"
  ],
  "title": "ApplyNamesRequest",
  "type": "object"
}
