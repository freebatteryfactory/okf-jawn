{
  "$defs": {
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "ItemKind": {
      "description": "Built-in presentation roles; user-defined OKF type names remain unrestricted.",
      "oneOf": [
        {
          "const": "note",
          "description": "Human or agent-authored Markdown knowledge.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "An appearance of immutable source bytes.",
          "type": "string"
        },
        {
          "const": "view",
          "description": "A source-bound declarative visual artifact.",
          "type": "string"
        }
      ]
    },
    "ItemSummary": {
      "additionalProperties": false,
      "description": "A navigable item description bound to a resolved workspace revision.",
      "properties": {
        "description": {
          "description": "One-line navigation summary.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable identity."
        },
        "kind": {
          "$ref": "#/$defs/ItemKind",
          "description": "Built-in rendering role."
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle",
          "description": "Presentation lifecycle."
        },
        "media_type": {
          "description": "Original MIME type if there is a source object.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Current relative OKF path."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved revision for this summary."
        },
        "title": {
          "description": "Human-readable title.",
          "type": "string"
        },
        "type_name": {
          "description": "User-selected OKF type; not a closed enum.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "title",
        "description",
        "type_name",
        "kind",
        "revision",
        "lifecycle"
      ],
      "type": "object"
    },
    "Lifecycle": {
      "description": "Application lifecycle distinct from business approval.",
      "oneOf": [
        {
          "const": "active",
          "description": "Current and usable content.",
          "type": "string"
        },
        {
          "const": "deprecated",
          "description": "Retained historical content.",
          "type": "string"
        },
        {
          "const": "archived",
          "description": "Hidden from ordinary current listings; still retrievable.",
          "type": "string"
        }
      ]
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "SourceAppearance": {
      "additionalProperties": false,
      "description": "One source occurrence; identical bytes do not imply identical meaning.",
      "properties": {
        "media_type": {
          "description": "Sniffed MIME type.",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Extracted metadata with original field names preserved.",
          "type": "object"
        },
        "names": {
          "description": "Observed aliases associated with this occurrence.",
          "items": {
            "$ref": "#/$defs/SourceName"
          },
          "type": "array"
        },
        "object": {
          "$ref": "#/$defs/Digest",
          "description": "Immutable object content hash."
        },
        "parent_item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Container or message parent."
        },
        "size": {
          "description": "Decimal byte count.",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit successor relationship; not inferred from arrival time."
        }
      },
      "required": [
        "object",
        "names",
        "media_type",
        "size",
        "metadata"
      ],
      "type": "object"
    },
    "SourceName": {
      "additionalProperties": false,
      "description": "An observed source name and location; not an authority assertion.",
      "properties": {
        "filename": {
          "description": "Original supplied filename.",
          "type": "string"
        },
        "folder": {
          "description": "Original relative location.",
          "type": "string"
        },
        "observed_at": {
          "description": "RFC 3339 observation time.",
          "type": "string"
        },
        "supplied_by": {
          "description": "Server-recorded source identity.",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "folder",
        "observed_at",
        "supplied_by"
      ],
      "type": "object"
    },
    "WorkspacePath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Editable Markdown and preserved frontmatter extension properties.",
  "properties": {
    "body": {
      "description": "Markdown body, preserving source locators.",
      "type": "string"
    },
    "properties": {
      "additionalProperties": true,
      "description": "All user and OKF properties; unknown extension values are retained.",
      "type": "object"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAppearance"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source occurrence metadata when applicable."
    },
    "summary": {
      "$ref": "#/$defs/ItemSummary",
      "description": "Identity and navigation metadata."
    }
  },
  "required": [
    "summary",
    "body",
    "properties"
  ],
  "title": "ItemDocument",
  "type": "object"
}
