{
  "$defs": {
    "AttentionItem": {
      "additionalProperties": false,
      "description": "An observation with a useful next action.",
      "properties": {
        "action": {
          "$ref": "#/$defs/OperationName",
          "description": "Suggested existing operation, never executable code."
        },
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Relevant item."
        },
        "kind": {
          "$ref": "#/$defs/AttentionKind",
          "description": "Diagnostic class."
        },
        "message": {
          "description": "Concrete explanation.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message",
        "action"
      ],
      "type": "object"
    },
    "AttentionKind": {
      "description": "Known maintenance conditions.",
      "oneOf": [
        {
          "const": "broken_link",
          "description": "A reference does not resolve.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "`stale_after` requires checking.",
          "type": "string"
        },
        {
          "const": "unreviewed",
          "description": "Agent-authored content has no covering review.",
          "type": "string"
        },
        {
          "const": "duplicate",
          "description": "Identical bytes have multiple visible appearances.",
          "type": "string"
        },
        {
          "const": "missing_description",
          "description": "Navigation summary is absent.",
          "type": "string"
        },
        {
          "const": "unprocessed",
          "description": "A source whose conversion is partial, failed or unsupported; action `redigest_item`.",
          "type": "string"
        },
        {
          "const": "extraction_warnings",
          "description": "A completed source whose conversion recorded warnings; action `read_item`.",
          "type": "string"
        },
        {
          "const": "newer_source",
          "description": "A pinned View has newer source data available.",
          "type": "string"
        },
        {
          "const": "instruction_like",
          "description": "Possible instruction-like source text; advisory only.",
          "type": "string"
        },
        {
          "const": "invalidated",
          "description": "A saved View or a citation refers to purged content; action `get_view`.",
          "type": "string"
        },
        {
          "const": "unparseable_header",
          "description": "An imported file's header does not parse; its bytes are kept and nothing is blocked.\nAction `get_item`.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
