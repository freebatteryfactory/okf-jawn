    "PageRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive document page range.",
      "properties": {
        "end": {
          "description": "Last page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First page.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "PageRegion": {
      "additionalProperties": false,
      "description": "A box on one page, slide or image of the original.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox",
          "description": "The box."
        },
        "page_no": {
          "description": "One-based page or slide number.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "page_size": {
          "$ref": "#/$defs/PageSize",
          "description": "The page's extent, so the box can be drawn over a page image on its own."
        }
      },
      "required": [
        "page_no",
        "bbox",
        "page_size"
      ],
      "type": "object"
    },
    "PageSize": {
      "additionalProperties": false,
      "description": "Extent of the page the box lies on, in the box's own unit (PDF points, image pixels, PPTX\nEMU). A reader draws the box over a page image by the ratio of the two, so it needs no unit.",
      "properties": {
        "height": {
          "description": "Page height.",
          "format": "double",
          "type": "number"
        },
        "width": {
          "description": "Page width.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Selection": {
      "description": "Explicit bounded source selection.\n\n`PartialEq` only: a `region` holds coordinates as `f64`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The complete source, subject to a visible response budget.",
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive line range.",
          "properties": {
            "kind": {
              "const": "lines",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/TextRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inclusive page range.",
          "properties": {
            "kind": {
              "const": "pages",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/PageRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Rectangular sheet range.",
          "properties": {
            "kind": {
              "const": "cells",
              "type": "string"
            },
            "range": {
              "$ref": "#/$defs/CellRange",
              "description": "Range."
            }
          },
          "required": [
            "kind",
            "range"
          ],
