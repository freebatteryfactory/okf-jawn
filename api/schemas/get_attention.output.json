{
  "$defs": {
    "AttentionItem": {
      "additionalProperties": false,
      "description": "An observation with a useful next action.",
      "properties": {
        "action": {
          "$ref": "#/$defs/OperationName",
          "description": "Suggested existing operation, never executable code."
        },
        "instruction_like": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstructionEvidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only for instruction-like warnings; absence never certifies safety."
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemSummary"
            },
            {
              "type": "null"
            }
          ],
          "description": "The item at the response's `revision`; absent when the observation is about no one\nitem or the item was purged."
        },
        "item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Relevant item."
        },
        "kind": {
          "$ref": "#/$defs/AttentionKind",
          "description": "Diagnostic class."
        },
        "message": {
          "description": "Concrete explanation.",
          "type": "string"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ],
          "description": "The place inside the item the observation is about, in the form `read_item` takes;\nabsent when it is about the whole item."
        }
      },
      "required": [
        "kind",
        "message",
        "action"
      ],
      "type": "object"
    },
    "AttentionKind": {
      "description": "Known maintenance conditions.",
      "oneOf": [
        {
          "const": "broken_link",
          "description": "A reference does not resolve.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "`stale_after` requires checking.",
          "type": "string"
        },
        {
          "const": "unreviewed",
          "description": "Agent-authored content has no covering review.",
          "type": "string"
        },
        {
          "const": "duplicate",
          "description": "Identical bytes have multiple visible appearances.",
          "type": "string"
        },
        {
          "const": "missing_description",
          "description": "Navigation summary is absent.",
          "type": "string"
        },
        {
          "const": "unprocessed",
          "description": "A source whose conversion is partial, failed or unsupported; action `redigest_item`.",
          "type": "string"
        },
        {
          "const": "extraction_warnings",
          "description": "A completed source whose conversion recorded warnings; action `read_item`.",
          "type": "string"
        },
        {
          "const": "newer_source",
          "description": "A pinned View has newer source data available.",
          "type": "string"
        },
        {
          "const": "instruction_like",
          "description": "Possible instruction-like source text; advisory only.",
          "type": "string"
        },
        {
          "const": "invalidated",
          "description": "A saved View or a citation refers to purged content; action `get_view`.",
          "type": "string"
        },
        {
          "const": "unparseable_header",
          "description": "An imported file's header does not parse; its bytes are kept and nothing is blocked.\nAction `get_item`.",
          "type": "string"
        },
        {
          "const": "uploads_waiting",
          "description": "Uploads that are complete and not imported, with their count and total size in the\nmessage; one row a workspace when any exist. Action `list_uploads`.",
          "type": "string"
        }
      ]
    },
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Docling's bounding box, copied as the converter gave it (rounded to two decimals).",
      "properties": {
        "b": {
          "description": "Bottom edge.",
          "format": "double",
          "type": "number"
        },
        "coord_origin": {
          "$ref": "#/$defs/CoordOrigin",
          "description": "Corner `t` and `b` are measured from."
        },
        "l": {
          "description": "Left edge.",
          "format": "double",
          "type": "number"
        },
        "r": {
          "description": "Right edge.",
          "format": "double",
          "type": "number"
        },
        "t": {
          "description": "Top edge.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "l",
        "t",
        "r",
        "b",
        "coord_origin"
      ],
      "type": "object"
    },
    "CellRange": {
      "additionalProperties": false,
      "description": "A one-based inclusive rectangular spreadsheet selection; the XLSX source locator.",
      "properties": {
        "column_end": {
          "description": "Last column, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "column_start": {
          "description": "First column, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_end": {
          "description": "Last row, inclusive.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "row_start": {
          "description": "First row, inclusive, starting at one.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "sheet": {
          "description": "Exact sheet name.",
          "type": "string"
        }
      },
      "required": [
        "sheet",
        "row_start",
        "row_end",
        "column_start",
        "column_end"
      ],
      "type": "object"
    },
    "CoordOrigin": {
      "description": "Docling's `coord_origin`: which corner `t` and `b` are measured from.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Docling `TOPLEFT`.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Docling `BOTTOMLEFT`.",
          "type": "string"
        }
      ]
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ExtractionStatus": {
      "description": "The converter's verdict on one source, as a listing and a filter use it.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Accepted; no conversion has finished.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "Every page, or the whole non-paginated document, was converted.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "A document was produced but part of the source is missing from it.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The converter produced no document; the bytes are retained.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "No converter exists for this format; the bytes are retained.",
          "type": "string"
        }
      ]
    },
    "ExtractionSummary": {
      "additionalProperties": false,
      "description": "What a listing shows about one source.",
      "properties": {
        "corrected": {
          "description": "A human correction is shown over that text.",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ExtractionStatus",
          "description": "The converter's verdict."
        },
        "text_origin": {
          "$ref": "#/$defs/TextOrigin",
          "description": "Whose text is shown."
        }
      },
      "required": [
        "status",
        "text_origin",
        "corrected"
      ],
      "type": "object"
    },
    "InstructionEvidence": {
      "additionalProperties": false,
      "description": "Bounded current evidence for one item's instruction-like observation.",
      "properties": {
        "findings": {
          "description": "First matches in source order, at most 32 for version one.",
          "items": {
            "$ref": "#/$defs/InstructionFinding"
          },
          "maxItems": 32,
          "type": "array"
        },
        "language": {
          "description": "Language supported by this rule set; version one is English only (`en`).",
          "type": "string"
        },
        "omitted_findings": {
          "description": "Additional matches counted but not included in this bounded evidence list.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "language",
        "findings",
        "omitted_findings"
      ],
      "type": "object"
    },
    "InstructionFinding": {
      "additionalProperties": false,
      "description": "One advisory match, quoted from the original text and located like an ordinary citation.",
      "properties": {
        "passage": {
          "description": "Original matching lines; normalization never rewrites the displayed evidence.",
          "type": "string"
        },
        "rule_id": {
          "$ref": "#/$defs/InstructionRule",
          "description": "Rule that matched, not a verdict about intent or safety."
        },
        "rule_set_version": {
          "description": "Exact version of the rules that produced this finding.",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference",
          "description": "The same revision, representation and locator used by application reads."
        }
      },
      "required": [
        "rule_id",
        "rule_set_version",
        "passage",
        "source"
      ],
      "type": "object"
    },
    "InstructionRule": {
      "description": "Explainable rules in the local English instruction-warning detector.",
      "oneOf": [
        {
          "const": "role_impersonation",
          "description": "Text impersonates a system, developer or administrator message.",
          "type": "string"
        },
        {
          "const": "override_instructions",
          "description": "Text asks for earlier instructions to be ignored or overridden.",
          "type": "string"
        },
        {
          "const": "reveal_secrets",
          "description": "Text asks for credentials, prompts or hidden instructions.",
          "type": "string"
        },
        {
          "const": "external_action",
          "description": "Text asks an assistant to execute an action or send data elsewhere.",
          "type": "string"
        },
        {
          "const": "hidden_text",
          "description": "Invisible or bidirectional controls occur within the text.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "ItemKind": {
      "description": "Built-in presentation roles; user-defined OKF type names remain unrestricted.",
      "oneOf": [
        {
          "const": "note",
          "description": "Human or agent-authored Markdown knowledge.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "An appearance of immutable source bytes.",
          "type": "string"
        },
        {
          "const": "view",
          "description": "A source-bound declarative visual artifact. Its file is an OKF concept: the `title`\nproperty, then a body that is the View's description as Markdown followed by exactly one\nfenced code block whose info string is `json okf-jawn-view`, holding `schema_version`, `mode`,\n`grammar`, `bindings` (without `workspace_id`, `locations` or `materialized`, which the\nserver derives), `spec` and `charts`; the block ends the body.",
          "type": "string"
        }
      ]
    },
    "ItemStatus": {
      "description": "OKF's `status` word of an item, distinct from business approval and from archiving.\n\nAn absent OKF `status` reads `stable`. `other` is a producer's value outside the three,\nkept exactly as written in the file's `status` property; it cannot be set through\n`set_lifecycle`.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Work in progress.",
          "type": "string"
        },
        {
          "const": "stable",
          "description": "Current and usable content.",
          "type": "string"
        },
        {
          "const": "deprecated",
          "description": "Retained, superseded content; still searchable.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A status word outside the three, preserved in the file.",
          "type": "string"
        }
      ]
    },
    "ItemSummary": {
      "additionalProperties": false,
      "description": "A navigable item description bound to a resolved workspace revision.",
      "properties": {
        "archived": {
          "description": "Hidden from ordinary current listings; reversible and keeps history.",
          "type": "boolean"
        },
        "description": {
          "description": "One-line navigation summary.",
          "type": "string"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionSummary"
            },
            {
              "type": "null"
            }
          ],
          "description": "The converter's verdict and whose text is shown; present exactly when `kind` is `source`."
        },
        "id": {
          "$ref": "#/$defs/ItemId",
          "description": "Stable identity."
        },
        "kind": {
          "$ref": "#/$defs/ItemKind",
          "description": "Built-in rendering role."
        },
        "media_type": {
          "description": "Original MIME type if there is a source object.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "$ref": "#/$defs/WorkspacePath",
          "description": "Current relative OKF path."
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "Resolved revision for this summary."
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "description": "OKF status word."
        },
        "title": {
          "description": "Human-readable title.",
          "type": "string"
        },
        "type_name": {
          "description": "User-selected OKF type; not a closed enum.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "title",
        "description",
        "type_name",
        "kind",
        "revision",
        "status",
        "archived"
      ],
      "type": "object"
    },
