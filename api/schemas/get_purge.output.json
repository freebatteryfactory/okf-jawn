    "PurgeId": {
      "description": "Identity of one purge; its record outlives what it removed.",
      "format": "uuid",
      "type": "string"
    },
    "PurgeReport": {
      "additionalProperties": false,
      "description": "What a completed purge did; counts only.",
      "properties": {
        "backups_removed": {
          "description": "Managed backups deleted (workspace archives, and their copies in pre-migration backups).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "backups_rewritten": {
          "description": "Managed backups rewritten without the target.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "citations_invalidated": {
          "description": "Stored citations (reviews, receipts, comments, View bindings) of the target invalidated.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "citations_remapped": {
          "description": "Stored citations of other items remapped to a rewritten revision.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "drafts_removed": {
          "description": "Drafts deleted.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "exports_removed": {
          "description": "Retained export and View export artifacts deleted.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "objects_kept_shared": {
          "description": "Objects kept because a surviving item still references them, as a decimal string.",
          "type": "string"
        },
        "objects_removed": {
          "description": "Stored objects deleted, as a decimal string.",
          "type": "string"
        },
        "proposals_removed": {
          "description": "Proposals deleted with their candidate references and comments.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "revisions_invalidated": {
          "description": "Revisions that no longer exist or were rewritten.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "views_invalidated": {
          "description": "Saved Views with an invalidated binding.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "objects_removed",
        "objects_kept_shared",
        "backups_removed",
        "backups_rewritten",
        "exports_removed",
        "proposals_removed",
        "drafts_removed",
        "revisions_invalidated",
        "citations_remapped",
        "citations_invalidated",
        "views_invalidated"
      ],
      "type": "object"
    },
    "PurgeState": {
      "description": "Progress of a purge.",
      "oneOf": [
        {
          "const": "requested",
          "description": "Accepted; nothing removed yet.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Removing.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "Every application-managed copy is removed or rewritten; no affected backup is restorable.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Stopped; repeating the request resumes it.",
          "type": "string"
        }
      ]
    },
    "PurgeTarget": {
      "description": "What a purge removes; identities only, never a name or a path.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A whole workspace.",
          "properties": {
            "kind": {
              "const": "workspace",
              "type": "string"
            },
            "workspace_id": {
              "$ref": "#/$defs/WorkspaceId",
              "description": "Removed workspace."
            }
          },
          "required": [
            "kind",
            "workspace_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One item.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "Removed item."
            },
            "kind": {
              "const": "item",
              "type": "string"
            },
            "workspace_id": {
              "$ref": "#/$defs/WorkspaceId",
              "description": "Its workspace."
            }
          },
          "required": [
            "kind",
            "workspace_id",
            "item_id"
          ],
          "type": "object"
        }
      ]
    },
    "Revision": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
