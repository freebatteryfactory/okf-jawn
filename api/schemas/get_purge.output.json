{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "description": "A safe error response, not an internal backtrace.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "description": "Stable code for programmatic handling."
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ],
          "description": "Typed context for conflict, replay, and in-progress outcomes."
        },
        "field": {
          "description": "Input field needing correction.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "description": "Safe explanation for the caller.",
          "type": "string"
        },
        "request_id": {
          "description": "Correlation identifier, not a secret.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ConnectorId": {
      "description": "Identity of one local MCP connector credential, never the owner's browser session.",
      "format": "uuid",
      "type": "string"
    },
    "DraftConflictItem": {
      "additionalProperties": false,
      "description": "One snapshotted item whose committed content moved after its draft's base.\n\nThe editor resolves it per item, with `changes` as the diff: keep mine is `save_draft` with\n`base_revision` = `current_revision`, then `commit_items`; take theirs is `discard_draft`.",
      "properties": {
        "changes": {
          "description": "The item's committed changes from `draft_base` to `current_revision`.",
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "current_revision": {
          "$ref": "#/$defs/Revision",
          "description": "Head revision at which the item was found changed or deleted."
        },
        "deleted": {
          "description": "The item no longer exists at `current_revision`.",
          "type": "boolean"
        },
        "draft_base": {
          "$ref": "#/$defs/Revision",
          "description": "Revision the draft was based on."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "Item whose draft no longer applies cleanly."
        }
      },
      "required": [
        "item_id",
        "draft_base",
        "current_revision",
        "deleted",
        "changes"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Stable failure classifications; HTTP and MCP adapters preserve these.",
      "oneOf": [
        {
          "const": "invalid_input",
          "description": "Input violates the declared contract.",
          "type": "string"
        },
        {
          "const": "unauthenticated",
          "description": "No acceptable identity was established.",
          "type": "string"
        },
        {
          "const": "forbidden",
          "description": "The principal lacks the required capability.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The resource is absent or not visible to this principal.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "A precondition, revision, draft-base, or idempotency-key conflict occurred.",
          "type": "string"
        },
        {
          "const": "already_issued",
          "description": "A secret-bearing write already completed; replaying it never returns the secret again.",
          "type": "string"
        },
        {
          "const": "in_progress",
          "description": "Another attempt with the same idempotency key holds a live lease; retry later.",
          "type": "string"
        },
        {
          "const": "too_large",
          "description": "A configured resource limit was exceeded.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The requested representation or format is unsupported.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "A configured integration is unavailable.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The operation was cancelled.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "An unexpected server failure occurred without exposing secrets.",
          "type": "string"
        },
        {
          "const": "not_implemented",
          "description": "The operation is declared but this build does not implement it; never a success.",
          "type": "string"
        }
      ]
    },
    "ErrorDetail": {
      "description": "Typed failure context the UI and agents can act on without parsing messages.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The connector was already issued under this idempotency key; its secret is not replayed.",
          "properties": {
            "connector_id": {
              "$ref": "#/$defs/ConnectorId",
              "description": "Connector created by the original request."
            },
            "kind": {
              "const": "already_issued",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "connector_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An identical request is executing under a live lease.",
          "properties": {
            "kind": {
              "const": "in_progress",
              "type": "string"
            },
            "mutation_id": {
              "$ref": "#/$defs/MutationId",
              "description": "Mutation holding the lease."
            },
            "retry_after": {
              "description": "Whole seconds the caller should wait before retrying the same request.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "mutation_id",
            "retry_after"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One or more snapshotted items changed or were deleted after their drafts' bases.",
          "properties": {
            "items": {
              "description": "Every conflicting item, never only the first.",
              "items": {
                "$ref": "#/$defs/DraftConflictItem"
              },
              "minItems": 1,
              "type": "array"
            },
            "kind": {
              "const": "draft_conflict",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The idempotency key was reused with a different request body.",
          "properties": {
            "kind": {
              "const": "idempotency_conflict",
              "type": "string"
            },
            "operation": {
              "$ref": "#/$defs/OperationName",
              "description": "Operation that first used the key."
            }
          },
          "required": [
            "kind",
            "operation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The named revision was removed or rewritten by a purge; the code is `not_found`.",
          "properties": {
            "kind": {
              "const": "invalidated",
              "type": "string"
            },
            "purge_id": {
              "$ref": "#/$defs/PurgeId",
              "description": "The purge that removed or rewrote it."
            },
            "replacement": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ],
              "description": "After an item purge, the rewritten revision to re-pin to; absent after a\nworkspace purge."
            }
          },
          "required": [
            "kind",
            "purge_id"
          ],
          "type": "object"
        }
      ]
    },
    "FileChange": {
      "additionalProperties": false,
      "description": "A changed file with before and after locators.",
      "properties": {
        "binary": {
          "description": "The underlying bytes are binary.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/FileChangeKind",
          "description": "Added, modified, moved, or removed."
        },
        "new_path": {
          "description": "New path; absent for deletions.",
          "type": [
            "string",
            "null"
          ]
        },
        "old_path": {
          "description": "Previous path; absent for additions.",
          "type": [
            "string",
            "null"
          ]
        },
        "patch": {
          "description": "Unified text diff when applicable.",
          "type": "string"
        }
      },
      "required": [
        "patch",
        "binary",
        "kind"
      ],
      "type": "object"
    },
    "FileChangeKind": {
      "description": "How one file differs between two revisions.",
      "oneOf": [
        {
          "const": "added",
          "description": "Present only in the compared revision.",
          "type": "string"
        },
        {
          "const": "modified",
          "description": "Same path, different content.",
          "type": "string"
        },
        {
          "const": "moved",
          "description": "Different path for the same item.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "Present only in the base revision.",
          "type": "string"
        }
      ]
    },
    "ItemId": {
      "description": "Stable item identity independent of its current relative path.",
      "format": "uuid",
      "type": "string"
    },
    "JobId": {
      "description": "Durable background work identity retained across retries.",
      "format": "uuid",
      "type": "string"
    },
    "MutationId": {
      "description": "Durable server-assigned identity of one write; every store that creates a row enforces it as unique.",
      "format": "uuid",
      "type": "string"
    },
