{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "A user-defined type schema and UI hints.",
  "properties": {
    "name": {
      "description": "Exact user-facing OKF type name.",
      "type": "string"
    },
    "properties_schema": {
      "description": "JSON Schema for type-specific properties."
    },
    "schema_version": {
      "description": "Application format version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "ui_schema": {
      "description": "Presentation hints; never authorization rules."
    }
  },
  "required": [
    "name",
    "schema_version",
    "properties_schema",
    "ui_schema"
  ],
  "title": "TypeDefinition",
  "type": "object"
}
