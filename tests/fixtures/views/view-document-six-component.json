{
  "schema_version": 1,
  "title": "Six-component catalog view",
  "description": "ViewDocument wrapping the approved six-component json-render Spec for Phase 0 round-trip.",
  "mode": "pinned",
  "grammar": "json_render",
  "bindings": [],
  "spec": {
    "root": "root",
    "elements": {
      "root": {
        "type": "Stack",
        "props": { "title": "Six-component catalog" },
        "children": ["columns", "chart", "sources"],
        "slots": { "default": ["columns", "chart", "sources"] }
      },
      "columns": {
        "type": "Columns",
        "props": {},
        "children": ["excerpt", "table"],
        "slots": { "default": ["excerpt", "table"] }
      },
      "excerpt": {
        "type": "SourceExcerpt",
        "props": { "binding": "venue" },
        "children": []
      },
      "table": {
        "type": "DataTable",
        "props": { "binding": "metrics" },
        "children": []
      },
      "chart": {
        "type": "Chart",
        "props": { "binding": "metrics", "title": "Metrics chart" },
        "children": []
      },
      "sources": {
        "type": "SourceList",
        "props": { "bindings": ["venue", "metrics"] },
        "children": []
      }
    }
  }
}
