{
  "//": "Type-checks ui/tests without pulling the Hey API client island under exactOptionalPropertyTypes.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "bun"],
    "tsBuildInfoFile": "./.tsbuild/tests.tsbuildinfo",
    "rootDir": "."
  },
  "include": [
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "tests/fixtures/**/*.json",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["tests/e2e/**", "src/api/generated/client/**", "src/api/generated/core/**"],
  "references": [{ "path": "./tsconfig.generated.json" }]
}
