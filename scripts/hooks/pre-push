#!/bin/sh
# Tracked hook; `bun scripts/dev.mjs bootstrap` or `init` installs it through core.hooksPath.
# It never regenerates files and never touches another worktree.
set -eu
# Git exports GIT_DIR and GIT_INDEX_FILE to hooks. The offline tests create disposable
# repositories; with those variables set, their git commands would act on this repository.
unset $(git rev-parse --local-env-vars)
# Git passes one `<local ref> <local sha> <remote ref> <remote sha>` line per pushed ref on
# stdin. Read it first so that no check below can consume it.
refs=$(cat)
bun scripts/dev.mjs check-offline
cargo fmt --all --check
# Each pushed build/* ref is scope-checked, and every pushed ref has its qualification receipts
# checked, at the commit being pushed, not at the current HEAD. Stale receipts block main and
# integration/*; on any other ref they are printed as warnings.
printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*)
      case "$local_ref" in
        refs/heads/build/*) bun scripts/dev.mjs scope "${local_ref#refs/heads/build/}" --head "$local_sha" ;;
      esac
      if ! stale=$(bun scripts/dev.mjs check-receipts --head "$local_sha" 2>&1); then
        case "$remote_ref" in
          refs/heads/main|refs/heads/integration/*) printf '%s\n' "$stale" >&2; exit 1 ;;
          *) printf '%s\n' "$stale" | sed 's/^/warning: /' >&2 ;;
        esac
      fi ;;
  esac
done
